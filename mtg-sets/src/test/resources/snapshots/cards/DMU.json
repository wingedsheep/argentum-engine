                            "then": {
                                "type": "DrawCards",
                                "count": {
                                    "type": "Fixed",
                                    "amount": 1
                                }
                            },
                            "otherwise": {
                                "type": "Scry",
                                "count": 1
                            }
                        }
                    ]
                },
                "descriptionOverride": "Whenever a creature you control dies, put a phyresis counter on Weatherlight Compleated. Then draw a card if it has seven or more phyresis counters on it. If it doesn't, scry 1."
            }
        ],
        "staticAbilities": [
            {
                "type": "ConditionalStaticAbility",
                "ability": {
                    "type": "GrantCardType",
                    "cardType": "CREATURE"
                },
                "condition": {
                    "type": "Compare",
                    "left": {
                        "type": "EntityProperty",
                        "entity": "Self",
                        "numericProperty": {
                            "type": "CounterCount",
                            "counterType": "PHYRESIS"
                        }
                    },
                    "operator": "GTE",
                    "right": {
                        "type": "Fixed",
                        "amount": 4
                    }
                }
            },
            {
                "type": "ConditionalStaticAbility",
                "ability": {
                    "type": "GrantSubtype",
                    "subtype": "Phyrexian"
                },
                "condition": {
                    "type": "Compare",
                    "left": {
                        "type": "EntityProperty",
                        "entity": "Self",
                        "numericProperty": {
                            "type": "CounterCount",
                            "counterType": "PHYRESIS"
                        }
                    },
                    "operator": "GTE",
