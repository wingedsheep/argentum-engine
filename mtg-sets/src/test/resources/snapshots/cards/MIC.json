// Wilhelt, the Rotcleaver
{
    "name": "Wilhelt, the Rotcleaver",
    "manaCost": "{2}{U}{B}",
    "typeLine": "Legendary Creature — Zombie Warrior",
    "oracleText": "Whenever another Zombie you control dies, if it didn't have decayed, create a 2/2 black Zombie creature token with decayed. (It can't block. When it attacks, sacrifice it at end of combat.)\nAt the beginning of your end step, you may sacrifice a Zombie. If you do, draw a card.",
    "creatureStats": {
        "power": 3,
        "toughness": 3
    },
    "script": {
        "triggeredAbilities": [
            {
                "id": "Wilhelt, the Rotcleaver:1",
                "trigger": {
                    "type": "ZoneChangeEvent",
                    "filter": {
                        "cardPredicates": [
                            "IsCreature",
                            {
                                "type": "HasSubtype",
                                "subtype": "Zombie"
                            },
                            {
                                "type": "NotKeyword",
                                "keyword": "DECAYED"
                            }
                        ],
                        "controllerPredicate": "ControlledByYou"
                    },
                    "from": "Battlefield",
                    "to": "Graveyard"
                },
                "binding": "OTHER",
                "effect": {
                    "type": "CreateToken",
                    "power": 2,
                    "toughness": 2,
                    "colors": [
                        "BLACK"
                    ],
                    "creatureTypes": [
                        "Zombie"
                    ],
                    "keywords": [
                        "DECAYED"
                    ],
                    "imageUri": "https://cards.scryfall.io/normal/front/6/a/6adb8607-1066-451d-a719-74ad32358278.jpg?1783925226"
                },
                "descriptionOverride": "Whenever another Zombie you control dies, if it didn't have decayed, create a 2/2 black Zombie creature token with decayed."
            },
            {
                "id": "Wilhelt, the Rotcleaver:2",
                "trigger": {
                    "type": "StepEvent",
                    "step": "END"
                },
                "binding": "ANY",
                "effect": {
                    "type": "Gated",
                    "gate": "Gate.MayDecide",
                    "then": {
                        "type": "Gated",
                        "gate": {
                            "type": "Gate.DoAction",
                            "action": {
                                "type": "Sacrifice",
                                "filter": "permanent Zombie"
                            },
                            "successCriterion": "SuccessCriterion.PermanentsSacrificed"
                        },
                        "then": {
                            "type": "DrawCards",
                            "count": {
                                "type": "Fixed",
                                "amount": 1
                            }
                        }
                    }
                },
                "descriptionOverride": "At the beginning of your end step, you may sacrifice a Zombie. If you do, draw a card."
            }
        ]
    },
    "metadata": {
        "collectorNumber": "2",
        "rarity": "MYTHIC",
        "artist": "Chris Rallis",
        "imageUri": "https://cards.scryfall.io/normal/front/2/5/2501a911-d072-436d-ae3b-a5164e3b30aa.jpg?1783925384",
        "rulings": [
            {
                "date": "2021-09-24",
                "text": "Decayed represents a static ability and a triggered ability. “Decayed” means “This creature can't block” and “When this creature attacks, sacrifice it at end of combat.”"
            },
            {
                "date": "2021-09-24",
                "text": "Once a creature with decayed attacks, it will be sacrificed at end of combat, even if it no longer has decayed at that time."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE",
        "BLACK"
    ]
}
