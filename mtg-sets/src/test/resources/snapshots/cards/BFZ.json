// Blight Herder
{
    "name": "Blight Herder",
    "manaCost": "{5}",
    "typeLine": "Creature — Eldrazi Processor",
    "oracleText": "When you cast this spell, you may put two cards your opponents own from exile into their owners' graveyards. If you do, create three 1/1 colorless Eldrazi Scion creature tokens. They have \"Sacrifice this token: Add {C}.\"",
    "creatureStats": {
        "power": 4,
        "toughness": 5
    },
    "script": {
        "triggeredAbilities": [
            {
                "id": "Blight Herder:2",
                "trigger": "CastThisSpellEvent",
                "effect": {
                    "type": "Gated",
                    "gate": {
                        "type": "Gate.MayDecide",
                        "prompt": "Put two cards your opponents own from exile into their owners' graveyards?"
                    },
                    "then": {
                        "type": "Gated",
                        "gate": {
                            "type": "Gate.DoAction",
                            "action": {
                                "type": "Composite",
                                "effects": [
                                    {
                                        "type": "GatherCards",
                                        "source": {
                                            "type": "FromZone",
                                            "zone": "Exile",
                                            "player": "EachOpponent"
                                        },
                                        "storeAs": "gathered0"
                                    },
                                    {
                                        "type": "SelectFromCollection",
                                        "from": "gathered0",
                                        "selection": {
                                            "type": "ChooseExactly",
                                            "count": {
                                                "type": "Fixed",
                                                "amount": 2
                                            }
                                        },
                                        "storeSelected": "processed",
                                        "prompt": "Choose two cards your opponents own from exile to put into their owners' graveyards",
                                        "selectedLabel": "Put into graveyard"
                                    },
                                    {
                                        "type": "MoveCollection",
                                        "from": "processed",
                                        "destination": {
                                            "type": "ToZone",
                                            "zone": "Graveyard"
                                        }
                                    }
                                ]
                            },
                            "successCriterion": {
                                "type": "SuccessCriterion.CollectionNonEmpty",
                                "name": "processed",
                                "min": 2
                            }
                        },
                        "then": {
                            "type": "CreateToken",
                            "count": {
                                "type": "Fixed",
                                "amount": 3
                            },
                            "power": 1,
                            "toughness": 1,
                            "colors": [],
                            "creatureTypes": [
                                "Eldrazi",
                                "Scion"
                            ],
                            "imageUri": "https://cards.scryfall.io/normal/front/b/9/b999a0fe-d2d0-4367-9abb-6ce5f3764f19.jpg?1783938121",
                            "activatedAbilities": [
                                {
                                    "id": "Blight Herder:1",
                                    "cost": "CostSacrificeSelf",
                                    "effect": {
                                        "type": "AddColorlessMana",
                                        "amount": {
                                            "type": "Fixed",
                                            "amount": 1
                                        }
                                    },
                                    "timing": "ManaAbility",
                                    "isManaAbility": true,
                                    "descriptionOverride": "Sacrifice this token: Add {C}."
                                }
                            ]
                        }
                    }
                },
                "descriptionOverride": "When you cast this spell, you may put two cards your opponents own from exile into their owners' graveyards. If you do, create three 1/1 colorless Eldrazi Scion creature tokens. They have \"Sacrifice this token: Add {C}.\""
            }
        ]
    },
    "metadata": {
        "collectorNumber": "2",
        "rarity": "RARE",
        "artist": "Todd Lockwood",
        "imageUri": "https://cards.scryfall.io/normal/front/4/7/478c3a74-ff78-4041-8137-93356d370ece.jpg?1783938225",
        "rulings": [
            {
                "date": "2015-08-25",
                "text": "If a spell or ability requires that you put more than one exiled card into the graveyard, you may choose cards owned by different opponents. Each card chosen will be put into its owner's graveyard."
            },
            {
                "date": "2015-08-25",
                "text": "If a replacement effect will cause cards that would be put into a graveyard from anywhere to be exiled instead (such as the one created by Anafenza, the Foremost), you can still put an exiled card into its opponent's graveyard. The card becomes a new object and remains in exile. In this situation, you can't use a single exiled card if required to put more than one exiled card into the graveyard. Conversely, you could use the same card in this situation if two separate spells or abilities each required you to put a single exiled card into its owner's graveyard."
            },
            {
                "date": "2015-08-25",
                "text": "You can't look at face-down cards in exile unless an effect allows you to."
            },
            {
                "date": "2015-08-25",
                "text": "Face-down cards in exile are grouped using two criteria: what caused them to be exiled face down and when they were exiled face down. If you want to put a face-down card in exile into its owner's graveyard, you must first choose one of these groups and then choose a card from within that group at random. For example, say an artifact causes your opponent to exile their hand of three cards face down. Then on a later turn, that artifact causes your opponent to exile another two cards face down. If you use Wasteland Strangler to put one of those cards into their graveyard, you would pick the first or second pile and put a card chosen at random from that pile into the graveyard."
            },
            {
                "date": "2015-08-25",
                "text": "Eldrazi Scions are similar to Eldrazi Spawn, seen in the Zendikar block. Note that Eldrazi Scions are 1/1, not 0/1."
            },
            {
                "date": "2015-08-25",
                "text": "Eldrazi and Scion are each separate creature types. Anything that affects Eldrazi will affect these tokens, for example."
            },
            {
                "date": "2015-08-25",
                "text": "Sacrificing an Eldrazi Scion creature token to add {C} is a mana ability. It doesn't use the stack and can't be responded to."
            }
        ]
    },
    "colorIdentityOverride": []
}

