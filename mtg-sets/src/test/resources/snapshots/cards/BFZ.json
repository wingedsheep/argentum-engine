// Adverse Conditions
{
    "name": "Adverse Conditions",
    "manaCost": "{3}{U}",
    "typeLine": "Instant",
    "oracleText": "Devoid (This card has no color.)\nTap up to two target creatures. Those creatures don't untap during their controller's next untap step. Create a 1/1 colorless Eldrazi Scion creature token. It has \"Sacrifice this token: Add {C}.\"",
    "keywords": [
        "DEVOID"
    ],
    "script": {
        "spellEffect": {
            "type": "Composite",
            "effects": [
                {
                    "type": "ForEach",
                    "space": "IterationSpace.Targets",
                    "body": {
                        "type": "Composite",
                        "effects": [
                            {
                                "type": "TapUntap",
                                "target": {
                                    "type": "ContextTarget",
                                    "index": 0
                                }
                            },
                            {
                                "type": "GrantKeyword",
                                "keyword": "DOESNT_UNTAP",
                                "target": {
                                    "type": "ContextTarget",
                                    "index": 0
                                },
                                "duration": "UntilAfterAffectedControllersNextUntap"
                            }
                        ]
                    }
                },
                {
                    "type": "CreateToken",
                    "power": 1,
                    "toughness": 1,
                    "colors": [],
                    "creatureTypes": [
                        "Eldrazi",
                        "Scion"
                    ],
                    "imageUri": "https://cards.scryfall.io/normal/front/b/9/b999a0fe-d2d0-4367-9abb-6ce5f3764f19.jpg?1783938121",
                    "activatedAbilities": [
                        {
                            "id": "Adverse Conditions:1",
                            "cost": "CostSacrificeSelf",
                            "effect": {
                                "type": "AddColorlessMana",
                                "amount": {
                                    "type": "Fixed",
                                    "amount": 1
                                }
                            },
                            "timing": "ManaAbility",
                            "isManaAbility": true,
                            "descriptionOverride": "Sacrifice this token: Add {C}."
                        }
                    ]
                }
            ]
        },
        "targetRequirements": [
            {
                "type": "TargetObject",
                "count": 2,
                "optional": true,
                "filter": {
                    "baseFilter": "creature"
                },
                "id": "t0"
            }
        ]
    },
    "metadata": {
        "collectorNumber": "54",
        "rarity": "UNCOMMON",
        "artist": "Jason Rainville",
        "imageUri": "https://cards.scryfall.io/normal/front/0/3/03d86e0b-294f-41b8-a5cd-d3144a019334.jpg?1783938214",
        "rulings": [
            {
                "date": "2015-08-25",
                "text": "You can cast Adverse Conditions with no targets. When it resolves, you'll get an Eldrazi Scion. However, if you cast Adverse Conditions with any targets and all of those targets are illegal as it tries to resolve, it won't resolve and none of its effects will happen. You won't get the Eldrazi Scion in that case."
            },
            {
                "date": "2015-08-25",
                "text": "Adverse Conditions tracks the creatures, but not their controller. If either of the creatures changes controllers before its first controller's next untap step has come around, then it won't untap during its new controller's next untap step."
            },
            {
                "date": "2015-08-25",
                "text": "Sacrificing an Eldrazi Scion creature token to add {C} is a mana ability. It doesn't use the stack and can't be responded to."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE"
    ]
}

