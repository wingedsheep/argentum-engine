// Laelia, the Blade Reforged
{
    "name": "Laelia, the Blade Reforged",
    "manaCost": "{2}{R}",
    "typeLine": "Legendary Creature — Spirit Warrior",
    "oracleText": "Haste\nWhenever Laelia attacks, exile the top card of your library. You may play that card this turn.\nWhenever one or more cards are put into exile from your library and/or your graveyard, put a +1/+1 counter on Laelia.",
    "creatureStats": {
        "power": 2,
        "toughness": 2
    },
    "keywords": [
        "HASTE"
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Laelia, the Blade Reforged:1",
                "trigger": "AttackEvent",
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "GatherCards",
                            "source": {
                                "type": "TopOfLibrary",
                                "count": {
                                    "type": "Fixed",
                                    "amount": 1
                                }
                            },
                            "storeAs": "gathered0"
                        },
                        {
                            "type": "MoveCollection",
                            "from": "gathered0",
                            "destination": {
                                "type": "ToZone",
                                "zone": "Exile"
                            }
                        },
                        {
                            "type": "GrantMayPlayFromExile",
                            "from": "gathered0"
                        }
                    ]
                }
            },
            {
                "id": "Laelia, the Blade Reforged:2",
                "trigger": {
                    "type": "CardsPutIntoExileEvent",
                    "fromZones": [
                        "Library",
                        "Graveyard"
                    ],
                    "filter": "ctrl:you"
                },
                "binding": "ANY",
                "effect": {
                    "type": "AddCounters",
                    "counterType": "PLUS_ONE_PLUS_ONE",
                    "count": 1,
                    "target": "Self"
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "53",
        "rarity": "RARE",
        "artist": "Wisnu Tan",
        "imageUri": "https://cards.scryfall.io/normal/front/a/3/a3bb2881-e8fb-4fba-a9f9-d93e6ca24378.jpg?1783927592",
        "rulings": [
            {
                "date": "2024-06-07",
                "text": "The last ability triggers only once for each time cards are put into exile from your library and/or graveyard, no matter how many cards were exiled at the same time."
            },
            {
                "date": "2024-06-07",
                "text": "Laelia's last triggered ability doesn't care which player is exiling cards from the library or graveyard. Cards put into exile from your library or graveyard for any reason, such as the delve ability, cause the ability to trigger."
            },
            {
                "date": "2024-06-07",
                "text": "If you play a card this way, it leaves exile and becomes a new object. If it returns to exile later in the turn, you can't play it again."
            }
        ]
    },
    "colorIdentityOverride": [
        "RED"
    ]
}

// Tivash, Gloom Summoner
{
    "name": "Tivash, Gloom Summoner",
    "manaCost": "{4}{B}",
    "typeLine": "Legendary Creature — Human Warlock",
    "oracleText": "Lifelink\nAt the beginning of your end step, if you gained life this turn, you may pay X life, where X is the amount of life you gained this turn. If you do, create an X/X black Demon creature token with flying.",
    "creatureStats": {
        "power": 4,
        "toughness": 4
    },
    "keywords": [
        "LIFELINK"
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Tivash, Gloom Summoner:1",
                "trigger": {
                    "type": "StepEvent",
                    "step": "END"
                },
                "binding": "ANY",
                "effect": {
                    "type": "Gated",
                    "gate": {
                        "type": "Gate.MayPay",
                        "cost": {
                            "type": "PayDynamicLife",
                            "amount": {
                                "type": "TurnTracking",
                                "player": "You",
                                "tracker": "LIFE_GAINED"
                            }
                        }
                    },
                    "then": {
                        "type": "CreateToken",
                        "power": 0,
                        "toughness": 0,
                        "colors": [
                            "BLACK"
                        ],
                        "creatureTypes": [
                            "Demon"
                        ],
                        "keywords": [
                            "FLYING"
                        ],
                        "imageUri": "https://cards.scryfall.io/normal/front/c/6/c6df5992-9c1c-407d-9602-a6c659342a15.jpg?1783927202",
                        "dynamicPower": {
                            "type": "TurnTracking",
                            "player": "You",
                            "tracker": "LIFE_GAINED"
                        },
                        "dynamicToughness": {
                            "type": "TurnTracking",
                            "player": "You",
                            "tracker": "LIFE_GAINED"
                        }
                    }
                },
                "interveningIf": {
                    "type": "Compare",
                    "left": {
                        "type": "TurnTracking",
                        "player": "You",
                        "tracker": "LIFE_GAINED"
                    },
                    "operator": "GTE",
                    "right": {
                        "type": "Fixed",
                        "amount": 1
                    }
                },
                "descriptionOverride": "At the beginning of your end step, if you gained life this turn, you may pay X life, where X is the amount of life you gained this turn. If you do, create an X/X black Demon creature token with flying."
            }
        ]
    },
    "metadata": {
        "collectorNumber": "45",
        "rarity": "RARE",
        "artist": "Kieran Yanner",
        "imageUri": "https://cards.scryfall.io/normal/front/e/3/e3b2a152-7bb9-495d-ac84-516097754137.jpg?1783927596",
        "rulings": [
            {
                "date": "2021-04-16",
                "text": "Tivash's ability counts the total amount of life gained without considering any life you lost during that turn. For example, if you lost 3 life and gained 4 life earlier in the turn, you may pay 4 life to create a 4/4 Demon."
            },
            {
                "date": "2021-04-16",
                "text": "You can't pay less life than the amount of life you gained to create a smaller but less harmful Demon."
            },
            {
                "date": "2021-04-16",
                "text": "You need to gain life before the end step begins for the last ability to trigger."
            }
        ]
    }
}
