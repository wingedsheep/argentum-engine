// Aang, Airbending Master
{
    "name": "Aang, Airbending Master",
    "manaCost": "{4}{W}",
    "typeLine": "Legendary Creature — Human Avatar Ally",
    "oracleText": "When Aang enters, airbend another target creature. (Exile it. While it's exiled, its owner may cast it for {2} rather than its mana cost.)\nWhenever one or more creatures you control leave the battlefield without dying, you get an experience counter.\nAt the beginning of your upkeep, create a 1/1 white Ally creature token for each experience counter you have.",
    "creatureStats": {
        "power": 4,
        "toughness": 4
    },
    "script": {
        "triggeredAbilities": [
            {
                "id": "Aang, Airbending Master:1",
                "trigger": {
                    "type": "ZoneChangeEvent",
                    "to": "Battlefield"
                },
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "GatherCards",
                            "source": "ChosenTargets",
                            "storeAs": "airbendChosen"
                        },
                        {
                            "type": "MoveCollection",
                            "from": "airbendChosen",
                            "destination": {
                                "type": "ToZone",
                                "zone": "Exile"
                            },
                            "storeMovedAs": "airbendExiled"
                        },
                        {
                            "type": "GrantMayPlayFromExile",
                            "from": "airbendExiled",
                            "expiry": "Permanent",
                            "ownerControls": true,
                            "fixedAlternativeManaCost": "{2}"
                        },
                        {
                            "type": "Gated",
                            "gate": {
                                "type": "Gate.WhenCondition",
                                "condition": {
                                    "type": "CollectionContainsMatch",
                                    "collection": "airbendExiled"
                                }
                            },
                            "then": {
                                "type": "EmitBendEvent",
                                "bendType": "AIR"
                            }
                        }
                    ]
                },
                "targetRequirement": {
                    "type": "TargetOther",
                    "baseRequirement": {
                        "type": "TargetObject",
                        "filter": {
                            "baseFilter": "creature"
                        }
                    },
                    "id": "t0"
                },
                "descriptionOverride": "When Aang enters, airbend another target creature."
            },
            {
                "id": "Aang, Airbending Master:2",
                "trigger": {
                    "type": "LeaveBattlefieldWithoutDyingEvent",
                    "filter": "creature ctrl:you"
                },
                "binding": "ANY",
                "effect": {
                    "type": "AddCounters",
                    "counterType": "EXPERIENCE",
                    "count": 1,
                    "target": "Controller"
                }
            },
            {
                "id": "Aang, Airbending Master:3",
                "trigger": {
                    "type": "StepEvent",
                    "step": "UPKEEP"
                },
                "binding": "ANY",
                "effect": {
                    "type": "CreateToken",
                    "count": {
                        "type": "PlayerCounterCount",
                        "counterType": "EXPERIENCE"
                    },
                    "power": 1,
                    "toughness": 1,
                    "colors": [
                        "WHITE"
                    ],
                    "creatureTypes": [
                        "Ally"
                    ]
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "74",
        "rarity": "MYTHIC",
        "artist": "Tomoyo Asatani",
        "imageUri": "https://cards.scryfall.io/normal/front/d/e/de7a150b-1b0d-4928-a2cc-80a4b7412350.jpg?1783904837",
        "rulings": [
            {
                "date": "2025-10-02",
                "text": "All experience counters are identical, no matter how you got them. For example, the last ability will count experience counters that you got from the second ability, from another ability, from another copy of Aang, Airbending Master, and so on."
            },
            {
                "date": "2025-10-02",
                "text": "The experience counter goes on you, the player, not on Aang. You will keep that counter even if Aang, Airbending Master dies."
            },
            {
                "date": "2025-10-02",
                "text": "Tokens exiled this way will cease to exist and cannot be cast."
            },
            {
                "date": "2025-10-02",
                "text": "Lands exiled this way cannot be played from exile. (Lands that were animated by earthbend will be returned to the battlefield tapped when they're exiled.)"
            }
        ]
    },
    "colorIdentityOverride": [
        "WHITE"
    ]
}

