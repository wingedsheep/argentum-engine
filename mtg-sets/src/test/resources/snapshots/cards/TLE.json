// Earthshape
{
    "name": "Earthshape",
    "manaCost": "{2}{W}",
    "typeLine": "Instant",
    "oracleText": "Earthbend 3. Then each creature you control with power less than or equal to that land's power gains hexproof and indestructible until end of turn. You gain hexproof until end of turn.",
    "script": {
        "spellEffect": {
            "type": "Composite",
            "effects": [
                {
                    "type": "AnimateLand",
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    },
                    "power": 0,
                    "toughness": 0,
                    "duration": "Permanent"
                },
                {
                    "type": "GrantKeyword",
                    "keyword": "HASTE",
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    },
                    "duration": "Permanent"
                },
                {
                    "type": "AddCounters",
                    "counterType": "PLUS_ONE_PLUS_ONE",
                    "count": 3,
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    }
                },
                {
                    "type": "GrantTriggeredAbility",
                    "ability": {
                        "id": "earthbend_return_tapped",
                        "trigger": {
                            "type": "ZoneChangeEvent",
                            "from": "Battlefield"
                        },
                        "effect": {
                            "type": "Composite",
                            "effects": [
                                {
                                    "type": "MoveToZone",
                                    "target": "Self",
                                    "destination": "Battlefield",
                                    "placement": "Tapped",
                                    "fromZone": "Graveyard"
                                },
                                {
                                    "type": "MoveToZone",
                                    "target": "Self",
                                    "destination": "Battlefield",
                                    "placement": "Tapped",
                                    "fromZone": "Exile"
                                }
                            ]
                        },
                        "descriptionOverride": "When this dies or is exiled, return it to the battlefield tapped."
                    },
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    },
                    "duration": "Permanent"
                },
                {
                    "type": "EmitBendEvent",
                    "bendType": "EARTH"
                },
                {
                    "type": "ForEach",
                    "space": {
                        "type": "IterationSpace.Group",
                        "filter": {
                            "baseFilter": {
                                "cardPredicates": [
                                    "IsCreature",
                                    {
                                        "type": "PowerAtMostEntity",
