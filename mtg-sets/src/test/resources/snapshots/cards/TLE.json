                                            "name": "t0"
                                        }
                                    }
                                ],
                                "controllerPredicate": "ControlledByYou"
                            }
                        }
                    },
                    "body": {
                        "type": "Composite",
                        "effects": [
                            {
                                "type": "GrantKeyword",
                                "keyword": "HEXPROOF",
                                "target": "IterationEntity"
                            },
                            {
                                "type": "GrantKeyword",
                                "keyword": "INDESTRUCTIBLE",
                                "target": "IterationEntity"
                            }
                        ]
                    }
                },
                {
                    "type": "GrantEvasionKeyword",
                    "keyword": "HEXPROOF"
                }
            ]
        },
        "targetRequirements": [
            {
                "type": "TargetObject",
                "filter": {
                    "baseFilter": "land ctrl:you"
                },
                "id": "t0"
            }
        ]
    },
    "metadata": {
        "collectorNumber": "67",
        "rarity": "RARE",
        "artist": "Fahmi Fauzi",
        "imageUri": "https://cards.scryfall.io/normal/front/d/8/d873c678-c8f2-40f0-ab03-a2fdf5187aea.jpg?1783904839",
        "rulings": [
            {
                "date": "2025-10-02",
                "text": "If the targeted land becomes an illegal target before the spell or ability that includes earthbend resolves, earthbend does nothing. If the spell or ability didn't have other targets, it won't resolve."
            },
            {
                "date": "2025-10-02",
                "text": "You may target a land that is already a creature, perhaps because of a previous earthbend ability. The land will get the +1/+1 counters, gain haste, and have its base power and toughness set to 0/0."
            }
        ]
    },
    "colorIdentityOverride": [
        "WHITE"
    ]
