// Divine Intervention
{
    "name": "Divine Intervention",
    "manaCost": "{6}{W}{W}",
    "typeLine": "Enchantment",
    "oracleText": "This enchantment enters with two intervention counters on it.\nAt the beginning of your upkeep, remove an intervention counter from this enchantment.\nWhen you remove the last intervention counter from this enchantment, the game is a draw.",
    "script": {
        "triggeredAbilities": [
            {
                "id": "Divine Intervention:1",
                "trigger": {
                    "type": "StepEvent",
                    "step": "UPKEEP"
                },
                "binding": "ANY",
                "effect": {
                    "type": "RemoveCounters",
                    "counterType": "INTERVENTION",
                    "count": {
                        "type": "Fixed",
                        "amount": 1
                    },
                    "target": "Self"
                },
                "descriptionOverride": "At the beginning of your upkeep, remove an intervention counter from this enchantment."
            },
            {
                "id": "Divine Intervention:2",
                "trigger": {
                    "type": "CountersRemovedEvent",
                    "counterType": "INTERVENTION",
                    "lastRemoved": true,
                    "removedBy": "You"
                },
                "effect": "GameIsDraw",
                "descriptionOverride": "When you remove the last intervention counter from this enchantment, the game is a draw."
            }
        ],
        "replacementEffects": [
            {
                "type": "EntersWithCounters",
                "counterType": "INTERVENTION",
                "count": 2,
                "selfOnly": true
            }
        ]
    },
    "metadata": {
        "collectorNumber": "8",
        "rarity": "RARE",
        "artist": "Amy Weber",
        "imageUri": "https://cards.scryfall.io/normal/front/9/e/9eae0ba1-1383-4505-b4e7-4f17dd8f20c5.jpg?1783948087",
        "rulings": [
            {
                "date": "2009-10-01",
                "text": "When Divine Intervention's third ability resolves, the game ends immediately. The game is a draw, meaning neither player wins and neither player loses."
            },
            {
                "date": "2009-10-01",
                "text": "Divine Intervention's third ability triggers only if its controller removes the last intervention counter from it. It doesn't matter how that happens. For example, if you control Divine Intervention and the last intervention counter is removed as a result of a Clockspinning you control, the ability will trigger. On the other hand, if the last intervention counter is removed as a result of a Clockspinning another player controls, the ability won't trigger (and won't ever be able to)."
            },
            {
                "date": "2009-10-01",
                "text": "In a multiplayer game played with the limited range of influence option, Divine Intervention won't necessarily end the entire game when its third ability resolves. All players within range of Divine Intervention will leave the game. They'll neither win nor lose; as far as they're concerned, the result of the game is a draw. All other players will continue playing."
            }
        ]
    },
    "colorIdentityOverride": [
        "WHITE"
    ]
}

