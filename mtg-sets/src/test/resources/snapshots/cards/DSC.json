// Gleeful Arsonist
{
    "name": "Gleeful Arsonist",
    "manaCost": "{2}{R}",
    "typeLine": "Creature — Human Wizard",
    "oracleText": "Whenever an opponent casts a noncreature spell, this creature deals damage equal to its power to that player.\nUndying (When this creature dies, if it had no +1/+1 counters on it, return it to the battlefield under its owner's control with a +1/+1 counter on it.)",
    "creatureStats": {
        "power": 1,
        "toughness": 2
    },
    "keywords": [
        "UNDYING"
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Gleeful Arsonist:1",
                "trigger": {
                    "type": "SpellCastEvent",
                    "spellFilter": {
                        "cardPredicates": [
                            "IsNoncreature"
                        ]
                    },
                    "player": "EachOpponent"
                },
                "binding": "ANY",
                "effect": {
                    "type": "DealDamage",
                    "amount": {
                        "type": "EntityProperty",
                        "entity": "Self",
                        "numericProperty": "Power"
                    },
                    "target": {
                        "type": "PlayerRef",
                        "player": "TriggeringPlayer"
                    }
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "27",
        "rarity": "RARE",
        "artist": "Nereida",
        "flavorText": "\"Let the world burn!\"",
        "imageUri": "https://cards.scryfall.io/normal/front/b/b/bbb2956c-ef76-4e80-81d4-7f1ce6841d37.jpg?1783909657",
        "rulings": [
            {
                "date": "2024-09-20",
                "text": "Gleeful Arsonist's first ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered."
            },
            {
                "date": "2024-09-20",
                "text": "If Gleeful Arsonist is no longer on the battlefield when its first ability resolves, use its power as it last existed on the battlefield to determine how much damage it deals."
            }
        ]
    },
    "colorIdentityOverride": [
        "RED"
    ]
}

