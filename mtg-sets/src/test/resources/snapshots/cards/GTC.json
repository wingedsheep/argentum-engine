                                    "counterType": "LOYALTY"
                                }
                            },
                            "keywords": [
                                "INDESTRUCTIBLE"
                            ],
                            "creatureTypes": [
                                "Human",
                                "Soldier"
                            ]
                        },
                        {
                            "type": "PreventDamageShield",
                            "target": "Self"
                        }
                    ]
                },
