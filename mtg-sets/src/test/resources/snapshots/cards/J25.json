                    "attackerFilter": {
                        "cardPredicates": [
                            "IsCreature",
                            {
                                "type": "HasSubtype",
                                "subtype": "Goblin"
                            }
                        ]
                    }
                },
                "binding": "ANY",
                "effect": {
                    "type": "CreateToken",
                    "power": 1,
                    "toughness": 1,
                    "colors": [
