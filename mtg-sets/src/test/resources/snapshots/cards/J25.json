    },
    "script": {
        "staticAbilities": [
            {
                "type": "GrantTriggeredAbility",
                "ability": {
                    "id": "Dionus, Elvish Archdruid:1",
                    "trigger": "TapEvent",
                    "effect": {
                        "type": "Composite",
                        "effects": [
                            {
                                "type": "TapUntap",
                                "target": "Self",
                                "tap": false
                            },
                            {
                                "type": "AddCounters",
                                "counterType": "PLUS_ONE_PLUS_ONE",
                                "count": 1,
                                "target": "Self"
                            }
                        ]
                    },
                    "triggerRestriction": "IsYourTurn",
                    "oncePerTurn": true
                },
                "filter": {
                    "baseFilter": "permanent Elf ctrl:you"
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "52",
        "rarity": "UNCOMMON",
        "artist": "BODAX",
        "flavorText": "\"My people are like the great magnigoth trees. We've seen ice, flood, invasions, and wars, yet our roots remain strong.\"",
        "imageUri": "https://cards.scryfall.io/normal/front/5/a/5a3dfd71-9ec0-4842-b99d-c1833679f0c5.jpg?1783908855",
        "rulings": [
            {
                "date": "2024-11-08",
                "text": "Dionus's ability grants a triggered ability to itself as well as other Elves you control."
            },
            {
                "date": "2024-11-08",
                "text": "A permanent that enters tapped doesn't \"become tapped.\" As such, if it has the ability granted by Dionus, that ability won't trigger."
            },
            {
                "date": "2024-11-08",
                "text": "If Dionus leaves the battlefield while one or more triggered abilities generated by the ability it grants are still on the stack, those abilities will still resolve as normal."
            },
            {
                "date": "2024-11-08",
                "text": "If you somehow control multiple copies of Dionus, each permanent you control will have that many instances of the granted ability. These abilities are not redundant. For example, if you control two copies of Dionus and one becomes tapped during your turn, each of its granted abilities will trigger. When those abilities resolve, each one will untap that Dionus (if it's tapped at the time) and will put a +1/+1 counter on it regardless of whether it's tapped or untapped."
            },
            {
                "date": "2024-11-08",
                "text": "If Dionus leaves the battlefield and returns to the battlefield in the same turn, or if one Dionus leaves and another Dionus enters, the ability granted by the old one is different from the ability granted by the new one. This means that an Elf that already untapped and got a +1/+1 counter from the previous granted triggered ability could untap and get another +1/+1 counter from the new granted triggered ability if it becomes tapped again later that turn."
            }
        ]
    },
    "colorIdentityOverride": [
        "GREEN"
    ]
}

