// Mystic Remora
{
    "name": "Mystic Remora",
    "manaCost": "{U}",
    "typeLine": "Enchantment",
    "oracleText": "Cumulative upkeep {1} (At the beginning of your upkeep, put an age counter on this permanent, then sacrifice it unless you pay its upkeep cost for each age counter on it.)\nWhenever an opponent casts a noncreature spell, you may draw a card unless that player pays {4}.",
    "keywords": [
        "CUMULATIVE_UPKEEP"
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Mystic Remora:1",
                "trigger": {
                    "type": "StepEvent",
                    "step": "UPKEEP"
                },
                "binding": "ANY",
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "AddCounters",
                            "counterType": "AGE",
                            "count": 1,
                            "target": "Self"
                        },
                        {
                            "type": "Gated",
                            "gate": {
                                "type": "Gate.MayPay",
                                "cost": {
                                    "type": "PayDynamicManaCost",
                                    "amount": {
                                        "type": "Multiply",
                                        "amount": {
                                            "type": "EntityProperty",
                                            "entity": "Self",
                                            "numericProperty": {
                                                "type": "CounterCount",
                                                "counterType": "AGE"
                                            }
                                        },
                                        "multiplier": 1
                                    }
                                }
                            },
                            "then": {
                                "type": "Composite",
                                "effects": []
                            },
                            "otherwise": {
                                "type": "SacrificeTarget",
                                "target": "Self"
                            },
                            "descriptionOverride": "Pay cumulative upkeep ({1} for each age counter), or sacrifice this permanent?"
                        }
                    ]
                },
                "interveningIf": {
                    "type": "SourceInZone",
                    "zones": [
                        "Battlefield"
                    ]
                },
                "descriptionOverride": "Cumulative upkeep {1} (At the beginning of your upkeep, put an age counter on this permanent, then sacrifice it unless you pay its upkeep cost for each age counter on it.)"
            },
            {
                "id": "Mystic Remora:2",
                "trigger": {
                    "type": "SpellCastEvent",
                    "spellFilter": {
                        "cardPredicates": [
                            "IsNoncreature"
                        ]
                    },
                    "player": "EachOpponent"
                },
                "binding": "ANY",
                "effect": {
                    "type": "PayOrSuffer",
                    "cost": {
                        "type": "PayAtom",
                        "atom": {
                            "type": "AtomMana",
                            "cost": "{4}"
                        }
                    },
                    "suffer": {
                        "type": "Gated",
                        "gate": "Gate.MayDecide",
                        "then": {
                            "type": "DrawCards",
                            "count": {
                                "type": "Fixed",
                                "amount": 1
                            }
                        }
                    },
                    "player": {
                        "type": "PlayerRef",
                        "player": "TriggeringPlayer"
                    },
                    "consequenceDescription": "let Mystic Remora's controller draw a card"
                },
                "descriptionOverride": "Whenever an opponent casts a noncreature spell, you may draw a card unless that player pays {4}."
            }
        ]
    },
    "metadata": {
        "collectorNumber": "87",
        "artist": "Ken Meyer, Jr.",
        "imageUri": "https://cards.scryfall.io/normal/front/5/8/58e93dff-b774-4765-b7bd-d3957e42ff4a.jpg?1783947511",
        "rulings": [
            {
                "date": "2025-10-02",
                "text": "Paying cumulative upkeep is always optional. If it's not paid, the permanent with cumulative upkeep is sacrificed. Partial payments of the total cumulative upkeep cost can't be made. For example, if Mystic Remora has three age counters on it when its cumulative upkeep ability triggers, it gets another age counter and then its controller chooses to either pay {4} or sacrifice it."
            },
            {
                "date": "2025-10-02",
                "text": "Cumulative upkeep is a triggered ability that imposes an increasing cost on a permanent. \"Cumulative upkeep [cost]\" means \"At the beginning of your upkeep, if this permanent is on the battlefield, put an age counter on this permanent. Then you may pay [cost] for each age counter on it. If you don't, sacrifice it.\""
            }
        ]
    },
