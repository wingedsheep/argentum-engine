// 70,000 Light-Years from Home
{
    "name": "70,000 Light-Years from Home",
    "manaCost": "{1}{W}",
    "typeLine": "Sorcery",
    "oracleText": "Exile target creature or Spacecraft. Its controller may search their library for a basic land card, reveal it, put it into their hand, then shuffle.",
    "script": {
        "spellEffect": {
            "type": "Composite",
            "effects": [
                {
                    "type": "MoveToZone",
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    },
                    "destination": "Exile"
                },
                {
                    "type": "ForEach",
                    "space": {
                        "type": "IterationSpace.Players",
                        "players": {
                            "type": "ControllerOf",
                            "targetDescription": "target creature or Spacecraft"
                        }
                    },
                    "body": {
                        "type": "Gated",
                        "gate": "Gate.MayDecide",
                        "then": {
                            "type": "Composite",
                            "effects": [
                                {
                                    "type": "GatherCards",
                                    "source": {
                                        "type": "FromZone",
                                        "zone": "Library",
                                        "filter": "basicland"
                                    },
                                    "storeAs": "searchable",
                                    "search": true
                                },
                                {
                                    "type": "SelectFromCollection",
                                    "from": "searchable",
                                    "selection": {
                                        "type": "ChooseUpTo",
                                        "count": {
                                            "type": "Fixed",
                                            "amount": 1
                                        }
                                    },
                                    "storeSelected": "found",
                                    "prompt": "Search your library for a basic land card to put into your hand",
                                    "selectedLabel": "Put into your hand"
                                },
                                {
                                    "type": "MoveCollection",
                                    "from": "found",
                                    "destination": {
                                        "type": "ToZone",
                                        "zone": "Hand"
                                    },
                                    "revealed": true
                                },
                                "ShuffleLibrary",
                                "EmitLibrarySearchedEvent"
                            ]
                        }
                    }
                }
            ]
        },
        "targetRequirements": [
            {
                "type": "TargetObject",
                "filter": {
                    "baseFilter": {
                        "cardPredicates": [
                            {
                                "type": "Or",
                                "predicates": [
                                    "IsCreature",
                                    {
                                        "type": "And",
                                        "predicates": [
                                            "IsPermanent",
                                            {
                                                "type": "HasSubtype",
                                                "subtype": "Spacecraft"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                },
                "id": "t0"
            }
        ]
    },
    "metadata": {
        "collectorNumber": "1",
        "rarity": "UNCOMMON",
        "artist": "Ariel Orea",
        "flavorText": "\"If these sensors are working . . . we're on the other side of the Galaxy.\"\n—Ensign Harry Kim",
        "imageUri": "https://cards.scryfall.io/normal/front/0/2/02080f42-863a-471b-992b-67e35ef1b7b7.jpg"
    },
    "colorIdentityOverride": [
        "WHITE"
    ]
}

