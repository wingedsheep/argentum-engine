// Call the Coppercoats
{
    "name": "Call the Coppercoats",
    "manaCost": "{2}{W}",
    "typeLine": "Instant",
    "oracleText": "Strive — This spell costs {1}{W} more to cast for each target beyond the first.\nChoose any number of target opponents. Create X 1/1 white Human Soldier creature tokens, where X is the number of creatures those opponents control.",
    "script": {
        "spellEffect": {
            "type": "CreateToken",
            "count": {
                "type": "Count",
                "player": "EachTargetedPlayer",
                "zone": "Battlefield",
                "filter": "creature"
            },
            "power": 1,
            "toughness": 1,
            "colors": [
                "WHITE"
            ],
            "creatureTypes": [
                "Human",
                "Soldier"
            ],
            "imageUri": "https://cards.scryfall.io/normal/front/9/0/90de6d1e-e654-4f4a-8014-061ce69e540f.jpg?1783930948"
        },
        "targetRequirements": [
            {
                "type": "TargetOpponent",
                "unlimited": true,
                "id": "t0"
            }
        ],
        "staticAbilities": [
            {
                "type": "ModifySpellCost",
                "target": "SelfCast",
                "modification": {
                    "type": "IncreaseGenericBy",
                    "source": {
                        "type": "ChosenTargets",
                        "beyond": 1
                    }
                }
            },
            {
                "type": "ModifySpellCost",
                "target": "SelfCast",
                "modification": {
                    "type": "IncreaseColoredPerUnit",
                    "symbols": "{W}",
                    "countSource": {
                        "type": "ChosenTargets",
                        "beyond": 1
                    }
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "23",
        "rarity": "RARE",
        "artist": "Cristi Balanescu",
        "flavorText": "When the alarm crystals flash, Drannith's finest answer the call.",
        "imageUri": "https://cards.scryfall.io/normal/front/e/1/e11cb353-d864-4b22-bdaf-1d42c25f0918.jpg?1783931224",
        "rulings": [
            {
                "date": "2020-04-17",
                "text": "Any target opponents that are no longer legal targets by the time Call the Coppercoats resolves won't have their creatures counted when determining how many tokens you create."
            },
            {
                "date": "2020-04-17",
                "text": "You choose how many targets each spell with a strive ability has and what those targets are as you cast it. It's legal to cast such a spell with no targets, although this is rarely a good idea. You can't choose the same target more than once for a single strive spell."
            },
            {
                "date": "2020-04-17",
                "text": "The mana value of a strive spell doesn't change no matter how many targets it has."
            },
            {
                "date": "2020-04-17",
                "text": "If a spell or ability allows you to cast a strive spell without paying its mana cost, you must pay the additional cost for any targets beyond the first."
            }
        ]
    },
    "colorIdentityOverride": [
        "WHITE"
    ]
}

