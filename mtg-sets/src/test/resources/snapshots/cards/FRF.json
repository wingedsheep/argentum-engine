    "name": "Arcbond",
    "manaCost": "{2}{R}",
    "typeLine": "Instant",
    "oracleText": "Choose target creature. Whenever that creature is dealt damage this turn, it deals that much damage to each other creature and each player.",
    "script": {
        "spellEffect": {
            "type": "CreateDelayedTrigger",
            "effect": {
                "type": "Composite",
                "effects": [
                    {
                        "type": "ForEach",
                        "space": {
                            "type": "IterationSpace.Group",
                            "filter": {
                                "baseFilter": "creature",
                                "excludeTriggeringEntity": true
                            }
                        },
                        "body": {
                            "type": "DealDamage",
                            "amount": {
                                "type": "ContextProperty",
                                "key": "TRIGGER_DAMAGE_AMOUNT"
                            },
                            "target": "IterationEntity",
                            "damageSource": "TriggeringEntity"
                        }
                    },
                    {
                        "type": "ForEach",
                        "space": {
                            "type": "IterationSpace.Players",
                            "players": "Each"
                        },
                        "body": {
                            "type": "DealDamage",
                            "amount": {
                                "type": "ContextProperty",
                                "key": "TRIGGER_DAMAGE_AMOUNT"
                            },
                            "target": "Controller",
                            "damageSource": "TriggeringEntity"
                        }
                    }
                ]
            },
            "trigger": {
                "event": "DamageReceivedEvent"
            },
            "watchedTarget": {
                "type": "BoundVariable",
                "name": "t0"
            }
        },
        "targetRequirements": [
            {
                "type": "TargetObject",
                "filter": {
                    "baseFilter": "creature"
                },
                "id": "t0"
            }
        ]
    },
    "metadata": {
        "collectorNumber": "91",
        "rarity": "RARE",
        "artist": "Slawomir Maniak",
        "flavorText": "\"If you must die today, make your death worthy of legend.\"\n—Alesha, Who Smiles at Death",
        "imageUri": "https://cards.scryfall.io/normal/front/9/b/9bc397d1-50a8-46cd-98b2-7104f2241420.jpg?1783938692",
        "rulings": [
            {
                "date": "2014-11-24",
                "text": "The creature is the source of the new damage."
            },
            {
                "date": "2014-11-24",
                "text": "The delayed triggered ability Arcbond creates will trigger even if the target creature is dealt lethal damage. For example, if a 3/3 creature is targeted by Arcbond and later in the turn it blocks a 7/7 creature, the 3/3 creature will deal 7 damage each other creature and each player."
            },
            {
                "date": "2014-11-24",
                "text": "Damage dealt by the creature because of the ability Arcbond creates isn't combat damage, even if it was combat damage that caused the ability to trigger."
            }
        ]
    },
    "colorIdentityOverride": [
        "RED"
    ]
}

