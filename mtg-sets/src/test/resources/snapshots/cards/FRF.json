        "rulings": [
            {
                "date": "2021-03-19",
                "text": "While resolving Alesha's triggered ability, you can't pay the cost multiple times to return more than one creature card."
            },
            {
                "date": "2021-03-19",
                "text": "Alesha's triggered ability checks the card's power only in your graveyard. The creature will still be tapped and attacking if its power is greater than 2 after it's on the battlefield."
