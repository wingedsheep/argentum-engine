// Arcane Denial
{
    "name": "Arcane Denial",
    "manaCost": "{1}{U}",
    "typeLine": "Instant",
    "oracleText": "Counter target spell. Its controller may draw up to two cards at the beginning of the next turn's upkeep.\nYou draw a card at the beginning of the next turn's upkeep.",
    "script": {
        "spellEffect": {
            "type": "Composite",
            "effects": [
                {
                    "type": "CreateDelayedTrigger",
                    "step": "UPKEEP",
                    "effect": {
                        "type": "DrawUpTo",
                        "maxCards": 2,
                        "target": "TargetController"
                    },
                    "timing": "NextTurn"
                },
                {
                    "type": "CreateDelayedTrigger",
                    "step": "UPKEEP",
                    "effect": {
                        "type": "DrawCards",
                        "count": {
                            "type": "Fixed",
                            "amount": 1
                        }
                    },
                    "timing": "NextTurn"
                },
                "Counter"
            ]
        },
        "targetRequirements": [
            {
                "type": "TargetObject",
                "filter": {
                    "baseFilter": {},
                    "zone": "Stack"
                },
                "id": "t0"
            }
        ]
    },
    "metadata": {
        "collectorNumber": "22a",
        "artist": "Richard Kane Ferguson",
        "imageUri": "https://cards.scryfall.io/normal/front/b/0/b0c5728e-43e7-417a-ba18-5038345cec67.jpg?1783947197",
        "rulings": [
            {
                "date": "2007-09-16",
                "text": "The controller of the countered spell doesn't choose how many cards to draw until the relevant ability resolves. The player may draw 0, 1, or 2 cards. They choose the number before drawing any cards."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE"
    ]
}

