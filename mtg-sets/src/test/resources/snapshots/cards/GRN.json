                            "type": "ForceSacrifice",
                            "filter": "creature|planeswalker",
                            "target": {
                                "type": "PlayerRef",
                                "player": "Each"
                            }
                        },
                        {
                            "type": "ForEach",
                            "space": {
                                "type": "IterationSpace.Players",
                                "players": {
                                    "type": "InCollection",
                                    "collection": "collected2"
                                }
