    "creatureStats": {
        "power": 2,
        "toughness": 3
    },
    "keywords": [
        "FLYING",
        "DEATHTOUCH"
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Tegwyll, Duke of Splendor:1",
                "trigger": {
                    "type": "ZoneChangeEvent",
                    "filter": "permanent Faerie ctrl:you",
                    "from": "Battlefield",
                    "to": "Graveyard"
                },
                "binding": "OTHER",
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "DrawCards",
                            "count": {
