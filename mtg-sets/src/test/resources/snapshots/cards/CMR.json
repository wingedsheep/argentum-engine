    "manaCost": "{4}{G}{U}",
    "typeLine": "Legendary Creature — Serpent",
    "oracleText": "You may play an additional land on each of your turns.\nLandfall — Whenever a land you control enters, you may draw a card.",
    "creatureStats": {
        "power": 5,
        "toughness": 5
    },
    "script": {
        "triggeredAbilities": [
            {
