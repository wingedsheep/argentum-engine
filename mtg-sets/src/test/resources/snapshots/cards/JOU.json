// Athreos, God of Passage
{
    "name": "Athreos, God of Passage",
    "manaCost": "{1}{W}{B}",
    "typeLine": "Legendary Enchantment Creature — God",
    "oracleText": "Indestructible\nAs long as your devotion to white and black is less than seven, Athreos isn't a creature.\nWhenever another creature you own dies, return it to your hand unless target opponent pays 3 life.",
    "creatureStats": {
        "power": 5,
        "toughness": 4
    },
    "keywords": [
        "INDESTRUCTIBLE"
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Athreos, God of Passage:1",
                "trigger": {
                    "type": "ZoneChangeEvent",
                    "filter": "creature own:you",
                    "from": "Battlefield",
                    "to": "Graveyard"
                },
                "binding": "OTHER",
                "effect": {
                    "type": "PayOrSuffer",
                    "cost": {
                        "type": "PayAtom",
                        "atom": {
                            "type": "AtomPayLife",
                            "amount": {
                                "type": "Fixed",
                                "amount": 3
                            }
                        }
                    },
                    "suffer": {
                        "type": "MoveToZone",
                        "target": "TriggeringEntity",
                        "destination": "Hand",
                        "fromZone": "Graveyard"
                    },
                    "player": {
                        "type": "BoundVariable",
                        "name": "t0"
                    }
                },
                "targetRequirement": {
                    "type": "TargetOpponent",
                    "id": "t0"
                },
                "descriptionOverride": "Whenever another creature you own dies, return it to your hand unless target opponent pays 3 life."
            }
        ],
        "staticAbilities": [
            {
                "type": "ConditionalStaticAbility",
                "ability": {
                    "type": "RemoveCardType",
                    "cardType": "CREATURE"
                },
                "condition": {
                    "type": "Compare",
                    "left": {
                        "type": "DevotionTo",
                        "colors": [
                            "WHITE",
                            "BLACK"
                        ]
                    },
                    "operator": "LT",
                    "right": {
                        "type": "Fixed",
                        "amount": 7
                    }
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "146",
        "rarity": "MYTHIC",
        "artist": "Ryan Barger",
        "imageUri": "https://cards.scryfall.io/normal/front/5/2/52705c53-883e-4b6a-9c08-3fa35f6f17d5.jpg?1783939406",
        "rulings": [
            {
                "date": "2014-04-26",
                "text": "Athreos's last ability will trigger if a token creature you own dies. The target opponent has the option to pay 3 life, although the token can't return to your hand."
            },
            {
                "date": "2014-04-26",
                "text": "It doesn't matter who controlled the creature when it died. Athreos's last ability will trigger if you owned that creature."
            },
            {
                "date": "2014-04-26",
                "text": "The target opponent chooses whether to pay 3 life when Athreos's last ability resolves. You won't return the card to your hand if that player pays 3 life or if the card leaves the graveyard before the ability resolves."
            },
            {
                "date": "2014-04-26",
                "text": "If there are no legal targets for Athreos's last ability (perhaps because each of your opponents has hexproof), it will be removed from the stack with no effect. No one may pay 3 life and you won't return the creature card to your hand."
            },
            {
                "date": "2020-01-24",
                "text": "Your devotion to two colors is the number of mana symbols among mana costs of permanents you control that are the first color, the second, or both. If an effect counts your devotion to two colors, a hybrid symbol that is both of those colors is counted just once."
            },
            {
                "date": "2020-01-24",
                "text": "If a God stops being a creature, it loses the type creature and the creature type God. It continues to be a legendary enchantment."
            },
            {
                "date": "2020-01-24",
                "text": "The type-changing ability that can make a God not be a creature functions only on the battlefield. It's always a creature card in other zones, regardless of your devotion to its color. It's always a creature spell while it's on the stack."
            }
        ]
    },
    "colorIdentityOverride": [
        "WHITE",
        "BLACK"
    ]
}

