                                    "count": {
                                        "type": "Fixed",
                                        "amount": 1
                                    }
                                },
                                "storeSelected": "scepterImprint",
                                "prompt": "Choose an instant card with mana value 2 or less to exile"
                            },
                            {
                                "type": "MoveCollection",
                                "from": "scepterImprint",
                                "destination": {
                                    "type": "ToZone",
                                    "zone": "Exile"
