    "metadata": {
        "collectorNumber": "40",
        "rarity": "RARE",
        "artist": "Shreya Shetty",
        "imageUri": "https://cards.scryfall.io/normal/front/2/6/26012b65-7e0a-427e-945e-de24738517fb.jpg?1783936052",
        "rulings": [
            {
                "date": "2022-12-08",
                "text": "When you cycle this card, first the cycling ability goes on the stack, then the triggered ability goes on the stack on top of it. The triggered ability will resolve before you draw a card from the cycling ability."
            },
            {
                "date": "2022-12-08",
                "text": "The cycling ability and the triggered ability are separate. If the triggered ability doesn't resolve (because, for example, it has been countered, or all of its targets have become illegal), the cycling ability will still resolve, and you'll draw a card."
            },
            {
                "date": "2017-07-14",
                "text": "If you counter a delayed triggered ability that triggers at the beginning of the \"next\" occurrence of a specified step or phase, that ability won't trigger again the following time that phase or step occurs."
            },
            {
                "date": "2017-07-14",
                "text": "Abilities that create replacement effects, such as a permanent entering the battlefield tapped or with counters on it, can't be targeted. Abilities that apply \"as [this creature] enters the battlefield\" are also replacement effects and can't be targeted."
            },
            {
                "date": "2017-07-14",
                "text": "Mana abilities can't be targeted. An activated mana ability is one that could add mana as it resolves, doesn't have a target, and isn't a loyalty ability. A triggered mana ability is one that could add mana as it resolves and triggers on an activated mana ability."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE"
    ]
}

