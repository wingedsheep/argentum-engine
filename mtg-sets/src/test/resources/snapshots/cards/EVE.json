// Crumbling Ashes
{
    "name": "Crumbling Ashes",
    "manaCost": "{1}{B}",
    "typeLine": "Enchantment",
    "oracleText": "At the beginning of your upkeep, destroy target creature with a -1/-1 counter on it.",
    "script": {
        "triggeredAbilities": [
            {
                "id": "Crumbling Ashes:1",
                "trigger": {
                    "type": "StepEvent",
                    "step": "UPKEEP"
                },
                "binding": "ANY",
                "effect": {
                    "type": "MoveToZone",
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    },
                    "destination": "Graveyard",
                    "byDestruction": true
                },
                "targetRequirement": {
                    "type": "TargetObject",
                    "filter": {
                        "baseFilter": {
                            "cardPredicates": [
                                "IsCreature"
                            ],
                            "statePredicates": [
                                {
                                    "type": "HasCounter",
                                    "counterType": "MINUS_ONE_MINUS_ONE"
                                }
                            ]
                        }
                    },
                    "id": "t0"
                },
                "descriptionOverride": "At the beginning of your upkeep, destroy target creature with a -1/-1 counter on it."
            }
        ]
    },
    "metadata": {
        "collectorNumber": "35",
        "rarity": "UNCOMMON",
        "artist": "Chuck Lukacs",
        "flavorText": "\"I was there to watch my brothers' quenching. I drew the slightest warmth from their dying rage.\"\n—Illulia of Nighthearth",
        "imageUri": "https://cards.scryfall.io/normal/front/3/e/3e73ac3c-bd5a-4993-be65-76396b7d38ad.jpg?1783942687",
        "rulings": [
            {
                "date": "2008-08-01",
                "text": "This ability is mandatory. If you're the only player who controls a creature with a -1/-1 counter on it as your upkeep begins, you must target one of your own creatures."
            },
            {
                "date": "2008-08-01",
                "text": "You can't target a creature unless it already has a -1/-1 counter on it as your upkeep begins. Putting a -1/-1 counter on a creature during your upkeep won't let Crumbling Ashes destroy it that turn."
            },
            {
                "date": "2008-08-01",
                "text": "If the targeted creature loses all its -1/-1 counters by the time the ability resolves, the ability won't resolve because its only target is illegal. The creature won't be destroyed."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLACK"
    ]
}

