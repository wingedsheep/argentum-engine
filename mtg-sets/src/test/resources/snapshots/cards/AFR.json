                "level": 2,
                "cost": "{U}{R}",
                "staticAbilities": [
                    {
                        "type": "GrantActivatedAbility",
                        "ability": {
                            "id": "Sorcerer Class:2",
                            "cost": "CostTap",
                            "effect": {
                                "type": "AddManaOfChoice",
                                "colorSet": {
                                    "type": "ManaColorSet.Specific",
                                    "colors": [
                                        "BLUE",
                                        "RED"
                                    ]
                                },
                                "restriction": {
                                    "type": "AnyOf",
                                    "restrictions": [
                                        "InstantOrSorceryOnly",
                                        "ClassLevelUpOnly"
                                    ]
                                }
