                "level": 3,
                "cost": "{3}{U}{R}",
                "triggeredAbilities": [
                    {
                        "id": "Sorcerer Class:3",
                        "trigger": {
                            "type": "SpellCastEvent",
                            "spellFilter": {
                                "cardPredicates": [
                                    {
                                        "type": "Or",
                                        "predicates": [
                                            "IsInstant",
                                            "IsSorcery"
                                        ]
                                    }
                                ]
                            }
                        },
                        "binding": "ANY",
                        "effect": {
                            "type": "DealDamage",
                            "amount": {
                                "type": "SpellsCastThisTurn",
                                "filter": "instant|sorcery"
                            },
                            "target": {
                                "type": "PlayerRef",
                                "player": "EachOpponent"
                            },
                            "damageSource": "TriggeringEntity"
