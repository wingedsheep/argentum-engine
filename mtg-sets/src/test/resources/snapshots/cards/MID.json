    "name": "Contortionist Troupe",
    "manaCost": "{X}{G}",
    "typeLine": "Creature — Human",
    "oracleText": "This creature enters with X +1/+1 counters on it.\nCoven — At the beginning of your end step, if you control three or more creatures with different powers, put a +1/+1 counter on target creature you control.",
    "creatureStats": {
        "power": 0,
        "toughness": 0
    },
    "script": {
        "triggeredAbilities": [
            {
                "id": "Contortionist Troupe:1",
                "trigger": {
                    "type": "StepEvent",
                    "step": "END"
                },
                "binding": "ANY",
                "effect": {
                    "type": "AddCounters",
                    "counterType": "PLUS_ONE_PLUS_ONE",
                    "count": 1,
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    }
                },
                "targetRequirement": {
                    "type": "TargetObject",
                    "filter": {
                        "baseFilter": "creature ctrl:you"
                    },
                    "id": "t0"
                },
                "interveningIf": {
                    "type": "Compare",
                    "left": {
                        "type": "AggregateBattlefield",
                        "player": "You",
                        "filter": "creature",
                        "aggregation": "DISTINCT_VALUES",
                        "property": "POWER"
                    },
                    "operator": "GTE",
                    "right": {
                        "type": "Fixed",
                        "amount": 3
                    }
                }
            }
        ],
        "replacementEffects": [
            {
                "type": "EntersWithDynamicCounters",
                "count": "XValue"
            }
        ]
    },
    "metadata": {
        "collectorNumber": "178",
        "rarity": "UNCOMMON",
        "artist": "Jesper Ejsing",
        "flavorText": "\"Welcome to the greatest show in Kessig!\"",
        "imageUri": "https://cards.scryfall.io/normal/front/c/8/c81da535-04e4-4dc8-9e12-7b417aba2f39.jpg?1783925581",
        "rulings": [
            {
                "date": "2021-09-24",
                "text": "Many coven abilities, such as that of Dawnhart Wardens above, are triggered abilities with intervening if clauses. You must control three or more creatures with different powers at the time the ability triggers and at the time the ability tries to resolve. They do not, however, need to be the same set of creatures in both cases."
            },
            {
                "date": "2021-09-24",
                "text": "A creature has different power from another if their powers are different numbers. For example, a 1/1 creature and a 2/1 creature have different powers."
            },
            {
                "date": "2021-09-24",
                "text": "For three creatures to have different powers from one another, each of their powers needs to be different. A 1/1 creature, a 2/1 creature, and another 2/1 creature aren't three creatures with different powers, even though both 2/1 creatures have different power than the 1/1 creature."
            }
        ]
    },
    "colorIdentityOverride": [
        "GREEN"
    ]
}

