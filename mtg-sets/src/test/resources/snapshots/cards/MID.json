                        "property": "POWER"
                    },
                    "operator": "GTE",
                    "right": {
                        "type": "Fixed",
                        "amount": 3
                    }
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "30",
        "artist": "Denman Rooke",
        "flavorText": "\"By ancient magics, by angels' grace, we will survive this night.\"",
