        "rulings": [
            {
                "date": "2019-07-12",
                "text": "Repeated Reverberation's ability will copy any instant or sorcery spell or loyalty ability, not just one with targets."
            },
            {
                "date": "2019-07-12",
                "text": "Copies are created even if the spell or ability that caused Repeated Reverberation's ability to trigger has been countered by the time that ability resolves. The copies resolve before the original spell or ability."
            },
            {
                "date": "2019-07-12",
                "text": "The copies made by Repeated Reverberation's ability are created on the stack, so they're not \"cast\" or \"activated.\" Abilities that trigger when a player casts a spell or activate an ability don't trigger."
            },
            {
                "date": "2019-07-12",
                "text": "Copying a loyalty ability doesn't add or remove loyalty counters from any object."
            }
        ]
    }
