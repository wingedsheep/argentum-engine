                "isPlaneswalkerAbility": true
            },
            {
                "id": "Karn Liberated:3",
                "cost": {
                    "type": "CostLoyalty",
                    "change": -14
                },
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "GatherCards",
                            "source": "FromLinkedExile",
                            "storeAs": "gathered0"
                        },
                        {
                            "type": "FilterCollection",
                            "from": "gathered0",
                            "filter": {
