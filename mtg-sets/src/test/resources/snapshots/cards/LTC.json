// Aragorn, King of Gondor
{
    "name": "Aragorn, King of Gondor",
    "manaCost": "{1}{U}{R}{W}",
    "typeLine": "Legendary Creature — Human Noble",
    "oracleText": "Vigilance, lifelink\nWhen Aragorn enters, you become the monarch.\nWhenever Aragorn attacks, up to one target creature can't block this turn. If you're the monarch, creatures can't block this turn.",
    "creatureStats": {
        "power": 4,
        "toughness": 4
    },
    "keywords": [
        "VIGILANCE",
        "LIFELINK"
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Aragorn, King of Gondor:1",
                "trigger": {
                    "type": "ZoneChangeEvent",
                    "to": "Battlefield"
                },
                "effect": {
                    "type": "TakeDesignation",
                    "designation": "MONARCH"
                }
            },
            {
                "id": "Aragorn, King of Gondor:2",
                "trigger": "AttackEvent",
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "CantBlockTargetCreatures",
                            "target": {
                                "type": "BoundVariable",
                                "name": "t0"
                            }
                        },
                        {
                            "type": "Gated",
                            "gate": {
                                "type": "Gate.WhenCondition",
                                "condition": {
                                    "type": "PlayerHasDesignation",
                                    "designation": "MONARCH"
                                }
                            },
                            "then": {
                                "type": "CantBlockGroup",
                                "filter": {
                                    "baseFilter": "creature"
                                }
                            }
                        }
                    ]
                },
                "targetRequirement": {
                    "type": "TargetObject",
                    "optional": true,
                    "filter": {
                        "baseFilter": "creature"
                    },
                    "id": "t0"
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "5",
        "rarity": "MYTHIC",
        "artist": "Yongjae Choi",
        "flavorText": "\"In this place will I abide, and my heirs, unto the ending of the world.\"",
        "imageUri": "https://cards.scryfall.io/normal/front/1/c/1c7ac04c-8510-468b-aa6f-f249bde9ff87.jpg?1783916037",
        "rulings": [
            {
                "date": "2023-06-16",
                "text": "When Aragorn, King of Gondor's last ability triggers, you can choose not to target a creature, probably because you're the monarch and just want creatures to be unable to block this turn. However, if you do choose a target, and that target is illegal at the time the ability tries to resolve, the ability won't resolve and none of its effects will happen. Creatures will still be able to block this turn, even if you're the monarch."
            },
            {
                "date": "2023-06-16",
                "text": "The game starts with no monarch. Once an effect makes one player the monarch, the game will have exactly one monarch from that point forward. As a player becomes the monarch, the current monarch (if any) ceases being the monarch."
            },
            {
                "date": "2023-06-16",
                "text": "There are two inherent triggered abilities associated with being the monarch. These triggered abilities have no source and are controlled by the player who was the monarch at the time the abilities triggered. The full texts of these abilities are \"At the beginning of the monarch's end step, that player draws a card\" and \"Whenever a creature deals combat damage to the monarch, its controller becomes the monarch.\""
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE",
        "RED",
        "WHITE"
    ]
}

