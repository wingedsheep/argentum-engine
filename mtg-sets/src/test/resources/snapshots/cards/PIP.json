// Gary Clone
{
    "name": "Gary Clone",
    "manaCost": "{1}{W}",
    "typeLine": "Creature — Human Citizen",
    "oracleText": "Squad {2} (As an additional cost to cast this spell, you may pay {2} any number of times. When this creature enters, create that many tokens that are copies of it.)\nWhenever this creature attacks, each creature you control named Gary Clone gets +1/+0 until end of turn.",
    "creatureStats": {
        "power": 1,
        "toughness": 3
    },
    "keywords": [
        "SQUAD"
    ],
    "keywordAbilities": [
        {
            "type": "Kicker",
            "manaCost": "{2}",
            "multi": true,
            "displayPrefix": "Squad",
            "keyword": "SQUAD",
            "declaredSlot": "SQUAD"
        }
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Gary Clone:1",
                "trigger": {
                    "type": "ZoneChangeEvent",
                    "to": "Battlefield"
                },
                "effect": {
                    "type": "CreateTokenCopyOfTarget",
                    "target": "TriggeringEntity",
                    "count": {
                        "type": "CastChoice",
                        "slot": "SQUAD"
                    }
                },
                "interveningIf": {
                    "type": "CastChoiceMade",
                    "slot": "SQUAD"
                }
            },
            {
                "id": "Gary Clone:2",
                "trigger": "AttackEvent",
                "effect": {
                    "type": "ForEach",
                    "space": {
                        "type": "IterationSpace.Group",
                        "filter": {
                            "baseFilter": "creature name:Gary Clone ctrl:you"
                        }
                    },
                    "body": {
                        "type": "ModifyStats",
                        "powerModifier": {
                            "type": "Fixed",
                            "amount": 1
                        },
                        "toughnessModifier": {
                            "type": "Fixed",
                            "amount": 0
                        },
                        "target": "IterationEntity"
                    }
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "16",
        "rarity": "UNCOMMON",
        "artist": "Nicholas Gregory",
        "flavorText": "\"Gary!\"",
        "imageUri": "https://cards.scryfall.io/normal/front/a/4/a45346ac-54a9-4fda-bde7-92ff75ac34f7.jpg?1783912419",
        "rulings": [
            {
                "date": "2024-03-08",
                "text": "You may pay the squad cost any number of times. You will create a token that is a copy of that permanent for each time you paid the squad cost. If you paid the squad cost multiple times, the tokens will all enter the battlefield simultaneously."
            },
            {
                "date": "2024-03-08",
                "text": "If the spell is countered, the squad ability will not trigger, and no tokens will be created."
            },
            {
                "date": "2024-03-08",
                "text": "If the spell resolves but the creature with squad leaves the battlefield before its squad ability resolves, you'll still create the token copies."
            },
            {
                "date": "2024-03-08",
                "text": "The tokens created by the squad ability aren't \"cast,\" so any abilities that trigger when a spell is cast won't trigger for the copies."
            },
            {
                "date": "2024-03-08",
                "text": "If, for some reason, the creature doesn't have the squad ability when it's on the battlefield, the ability won't trigger, even if you've paid the squad cost one or more times."
            }
        ]
    }
}

// Luck Bobblehead
{
    "name": "Luck Bobblehead",
    "manaCost": "{3}",
    "typeLine": "Artifact — Bobblehead",
    "oracleText": "{T}: Add one mana of any color.\n{1}, {T}: Roll X six-sided dice, where X is the number of Bobbleheads you control. Create a tapped Treasure token for each even result. If you rolled 6 exactly seven times, you win the game.",
    "script": {
        "activatedAbilities": [
            {
                "id": "Luck Bobblehead:1",
                "cost": "CostTap",
                "effect": "AddManaOfChoice",
                "timing": "ManaAbility",
                "isManaAbility": true
            },
            {
                "id": "Luck Bobblehead:2",
                "cost": {
                    "type": "CostComposite",
                    "costs": [
                        {
                            "type": "CostAtomWrapper",
                            "atom": {
                                "type": "AtomMana",
                                "cost": "{1}"
                            }
                        },
                        "CostTap"
                    ]
                },
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "RollDice",
                            "count": {
                                "type": "AggregateBattlefield",
                                "player": "You",
                                "filter": "Bobblehead"
                            },
                            "resultCounts": {
                                "diceCount0": [
                                    2,
                                    4,
                                    6
                                ],
                                "diceCount1": [
                                    6
                                ]
                            }
                        },
                        {
                            "type": "CreatePredefinedToken",
                            "tokenType": "Treasure",
                            "tapped": true,
                            "dynamicCount": {
                                "type": "VariableReference",
                                "variableName": "diceCount0"
                            },
                            "imageUri": "https://cards.scryfall.io/normal/front/1/d/1d74d012-66ca-4a0c-9e90-e31e96730d4d.jpg?1783912040"
                        },
                        {
                            "type": "Gated",
                            "gate": {
                                "type": "Gate.WhenCondition",
                                "condition": {
                                    "type": "Compare",
                                    "left": {
                                        "type": "VariableReference",
                                        "variableName": "diceCount1"
                                    },
                                    "operator": "EQ",
                                    "right": {
                                        "type": "Fixed",
                                        "amount": 7
                                    }
                                }
                            },
                            "then": "WinGame"
                        }
                    ]
                },
                "descriptionOverride": "Roll a six-sided die for each Bobblehead you control. Create a tapped Treasure for each even result. Exactly seven sixes wins the game."
            }
        ]
    },
    "metadata": {
        "collectorNumber": "135",
        "rarity": "UNCOMMON",
        "artist": "Ørjan Ruttenborg Svendsen",
        "imageUri": "https://cards.scryfall.io/normal/front/1/3/13281945-47ff-464d-96ef-9b26ef6783fa.jpg?1783912379",
        "rulings": [
            {
                "date": "2024-03-08",
                "text": "The value of X is determined only once, as Luck Bobblehead’s last ability resolves."
            },
            {
                "date": "2024-03-08",
                "text": "You win the game only if you rolled 6 exactly seven times while resolving a single instance of Luck Bobblehead’s last ability. Results of previous die rolls, whether they’re from previous resolutions of Luck Bobblehead’s last ability or from other effects that instruct you to roll dice, don’t matter for the purposes of this effect."
            }
        ]
    }
}

