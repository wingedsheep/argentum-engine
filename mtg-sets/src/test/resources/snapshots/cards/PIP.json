                        "type": "BoundVariable",
                        "name": "t0"
                    },
                    "additionalCost": {
                        "type": "AdditionalAtom",
                        "atom": {
                            "type": "AtomExileFrom",
                            "zone": "Graveyard",
                            "count": 2,
                            "excludeSelf": true
                        }
                    }
                },
                "targetRequirement": {
                    "type": "TargetObject",
                    "filter": {
