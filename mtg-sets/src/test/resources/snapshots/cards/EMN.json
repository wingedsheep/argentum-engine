        "rulings": [
            {
                "date": "2025-01-24",
                "text": "For spells with {X} in their mana costs, use the value chosen for X to determine if the spell's mana value is 4 or less."
            },
            {
                "date": "2025-01-24",
                "text": "Spells that can't be countered can be exiled by Spell Queller's ability. They won't resolve."
