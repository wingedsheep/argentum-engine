                    "from": "Battlefield"
                },
                "effect": "EachPlayerDrawsForDamageDealtToSource"
            }
        ],
        "staticAbilities": [
            {
                "type": "GrantTriggeredAbility",
                "ability": {
                    "id": "Grothama, All-Devouring:1",
                    "trigger": "AttackEvent",
                    "effect": {
                        "type": "Gated",
                        "gate": "Gate.MayDecide",
                        "then": {
                            "type": "Fight",
