                            }
                        }
                    },
                    "targetRequirement": {
                        "type": "TargetObject",
                        "filter": {
                            "baseFilter": "creature name:Grothama, All-Devouring"
                        },
                        "id": "t0"
                    }
                },
                "filter": {
                    "baseFilter": "creature",
                    "excludeSelf": true
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "71",
        "rarity": "MYTHIC",
        "artist": "Mark Behm",
