// Chakram Retriever
{
    "name": "Chakram Retriever",
    "manaCost": "{4}{U}",
    "typeLine": "Creature — Elemental Dog",
    "oracleText": "Partner with Chakram Slinger (When this creature enters, target player may put Chakram Slinger into their hand from their library, then shuffle.)\nWhenever you cast a spell during your turn, untap target creature.",
