                        {
                            "type": "TargetObject",
                            "optional": true,
                            "filter": {
                                "baseFilter": "creature ctrl:opponent"
                            },
                            "id": "t1"
                        }
                    ],
                    "descriptionOverride": "When you do, it fights up to one target creature you don't control."
