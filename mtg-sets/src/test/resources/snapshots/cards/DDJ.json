// Goblin Electromancer
{
    "name": "Goblin Electromancer",
    "manaCost": "{U}{R}",
    "typeLine": "Creature — Goblin Wizard",
    "oracleText": "Instant and sorcery spells you cast cost {1} less to cast.",
    "creatureStats": {
        "power": 2,
        "toughness": 2
    },
    "script": {
        "staticAbilities": [
            {
                "type": "ModifySpellCost",
                "target": {
                    "type": "YouCast",
                    "filter": "instant|sorcery"
                },
                "modification": {
                    "type": "ReduceGeneric",
                    "amount": 1
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "3",
        "artist": "Svetlin Velinov",
        "flavorText": "When asked how much power is required, Izzet mages always answer \"more.\"",
        "imageUri": "https://cards.scryfall.io/normal/front/6/3/632af23c-eb5c-4725-afca-637e84cecf94.jpg?1783940425",
        "rulings": [
            {
                "date": "2018-10-05",
                "text": "Goblin Electromancer's effect reduces only generic mana in the spell's total cost."
            },
            {
                "date": "2017-03-14",
                "text": "Two Goblin Electromancers will make instant and sorcery spells you cast cost {2} less to cast, and so on."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE",
        "RED"
    ]
}

// Jarad, Golgari Lich Lord
{
    "name": "Jarad, Golgari Lich Lord",
    "manaCost": "{B}{B}{G}{G}",
    "typeLine": "Legendary Creature — Zombie Elf",
    "oracleText": "Jarad gets +1/+1 for each creature card in your graveyard.\n{1}{B}{G}, Sacrifice another creature: Each opponent loses life equal to the sacrificed creature's power.\nSacrifice a Swamp and a Forest: Return this card from your graveyard to your hand.",
    "creatureStats": {
        "power": 2,
        "toughness": 2
    },
    "script": {
        "activatedAbilities": [
            {
                "id": "Jarad, Golgari Lich Lord:1",
                "cost": {
                    "type": "CostComposite",
                    "costs": [
                        {
                            "type": "CostAtomWrapper",
                            "atom": {
                                "type": "AtomMana",
                                "cost": "{1}{B}{G}"
                            }
                        },
                        {
                            "type": "CostAtomWrapper",
                            "atom": {
                                "type": "AtomSacrifice",
                                "filter": "creature",
                                "excludeSelf": true
                            }
                        }
                    ]
                },
                "effect": {
                    "type": "LoseLife",
                    "amount": {
                        "type": "EntityProperty",
                        "entity": "SacrificedAsCost",
                        "numericProperty": "Power"
                    },
                    "target": {
                        "type": "PlayerRef",
                        "player": "EachOpponent"
                    }
                }
            },
            {
                "id": "Jarad, Golgari Lich Lord:2",
                "cost": {
                    "type": "CostComposite",
                    "costs": [
                        {
                            "type": "CostAtomWrapper",
                            "atom": {
                                "type": "AtomSacrifice",
                                "filter": "land Swamp"
                            }
                        },
                        {
                            "type": "CostAtomWrapper",
                            "atom": {
                                "type": "AtomSacrifice",
                                "filter": "land Forest"
                            }
                        }
                    ]
                },
                "effect": {
                    "type": "MoveToZone",
                    "target": "Self",
                    "destination": "Hand",
                    "fromZone": "Graveyard"
                },
                "activateFromZone": "Graveyard"
            }
        ],
        "staticAbilities": [
            {
                "type": "GrantDynamicStats",
                "filter": {
                    "baseFilter": "permanent",
                    "scope": "Self"
                },
                "powerBonus": {
                    "type": "Count",
                    "player": "You",
                    "zone": "Graveyard",
                    "filter": "creature"
                },
                "toughnessBonus": {
                    "type": "Count",
                    "player": "You",
                    "zone": "Graveyard",
                    "filter": "creature"
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "45",
        "rarity": "MYTHIC",
        "artist": "Svetlin Velinov",
        "imageUri": "https://cards.scryfall.io/normal/front/f/6/f6a2f10c-721c-40c7-8fe1-b4877a40fe96.jpg?1783940402",
        "rulings": [
            {
                "date": "2012-10-01",
                "text": "Jarad's first ability applies only when Jarad is on the battlefield."
            },
            {
                "date": "2012-10-01",
                "text": "The life loss is based on the power of the sacrificed creature as it last existed on the battlefield."
            },
            {
                "date": "2012-10-01",
                "text": "To activate Jarad's last ability, you must sacrifice two lands. It doesn't matter what other land types the two lands have, as long as one is a Swamp and one is a Forest. Even if one of the lands you sacrifice is both a Swamp and a Forest, you have to sacrifice another land that is a Swamp or a Forest."
            },
            {
                "date": "2012-10-01",
                "text": "You can sacrifice any land with the land type Swamp or Forest, not just ones named Swamp or Forest. For example, you could sacrifice two Overgrown Tombs."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLACK",
        "GREEN"
    ]
