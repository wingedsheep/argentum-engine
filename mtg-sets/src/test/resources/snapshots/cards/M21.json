                "effect": {
                    "type": "MoveToZone",
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    },
                    "destination": "Hand"
                },
                "targetRequirement": {
                    "type": "TargetObject",
                    "optional": true,
                    "filter": {
                        "baseFilter": "creature|planeswalker",
                        "excludeSelf": true
                    },
                    "id": "t0"
                }
            },
            {
                "id": "Barrin, Tolarian Archmage:2",
                "trigger": {
                    "type": "StepEvent",
                    "step": "END"
                },
                "binding": "ANY",
                "effect": {
                    "type": "DrawCards",
                    "count": {
                        "type": "Fixed",
                        "amount": 1
                    }
                },
                "interveningIf": {
                    "type": "Compare",
                    "left": {
                        "type": "TurnTracking",
                        "player": "You",
                        "tracker": "PERMANENTS_PUT_INTO_HAND_FROM_BATTLEFIELD"
