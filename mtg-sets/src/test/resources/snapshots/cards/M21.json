                    "operator": "GTE",
                    "right": {
                        "type": "Fixed",
                        "amount": 1
                    }
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "45",
        "rarity": "RARE",
        "artist": "Ryan Pancoast",
        "flavorText": "\"There is no age at which you stop learning.\"",
        "imageUri": "https://cards.scryfall.io/normal/front/c/b/cb078fbb-beb9-4c0b-be93-ed1e73e6f8d8.jpg?1783930730",
        "rulings": [
            {
                "date": "2020-06-23",
                "text": "You draw only one card, no matter how many permanents were put into your hand from the battlefield during that turn."
            },
            {
                "date": "2020-06-23",
                "text": "The permanent that was returned to your hand doesn't have to still be there."
            },
            {
                "date": "2020-06-23",
                "text": "If a token is returned to your hand, it's put there before it ceases to exist."
            },
            {
                "date": "2020-06-23",
                "text": "Barrin's last ability checks the entire turn, even before Barrin was on the battlefield."
            },
            {
                "date": "2020-06-23",
                "text": "If a permanent wasn't put into your hand from the battlefield before your end step begins, Barrin's ability doesn't trigger at all."
            }
        ]
