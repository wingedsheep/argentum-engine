    "name": "Fiery Emancipation",
    "manaCost": "{3}{R}{R}{R}",
    "typeLine": "Enchantment",
    "oracleText": "If a source you control would deal damage to a permanent or player, it deals triple that damage to that permanent or player instead.",
    "script": {
        "replacementEffects": [
            {
                "type": "DoubleDamage",
                "appliesTo": {
                    "type": "DamageEvent",
                    "source": {
                        "controllerPredicate": "ControlledByYou"
                    }
                },
                "multiplier": 3
            }
        ]
    },
    "metadata": {
        "collectorNumber": "143",
        "rarity": "MYTHIC",
        "artist": "Alexander Forssberg",
        "flavorText": "\"One day the mountain's fire will rise up to burn away our chains and end this age of oppression.\"\n—*The Molten Prophecy*",
        "imageUri": "https://cards.scryfall.io/normal/front/0/b/0b12e4b7-2c45-4795-94d3-901f89b8f290.jpg?1783930692",
        "rulings": [
            {
                "date": "2023-09-01",
                "text": "If multiple replacement or prevention effects try to modify damage that would be dealt to a player or permanent, the player or the controller of the permanent chooses the order in which they apply."
            },
            {
                "date": "2020-06-23",
                "text": "If a creature with trample you control would deal combat damage to a blocking creature while you control Fiery Emancipation, you must assign its unmodified damage. For example, a 3/3 creature with trample blocked by a 2/2 creature can have 2 damage assigned to the blocking creature and 1 damage assigned to the defending player. It will then deal 6 damage to the blocking creature and 3 damage to the defending player."
            },
            {
                "date": "2020-06-23",
                "text": "If an effect asks you to divide damage among targets, you must divide the unmodified damage before tripling it."
            }
        ]
    },
    "colorIdentityOverride": [
        "RED"
    ]
}

