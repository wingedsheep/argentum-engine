                {
                    "type": "ForEach",
                    "space": {
                        "type": "IterationSpace.Collection",
                        "collection": "matching1"
                    },
                    "body": {
                        "type": "MarkMustAttack",
                        "target": "IterationEntity"
                    }
                }
            ]
        },
        "targetRequirements": [
