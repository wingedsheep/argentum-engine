    "name": "Killing Wave",
    "manaCost": "{X}{B}",
    "typeLine": "Sorcery",
    "oracleText": "For each creature, its controller sacrifices it unless they pay X life.",
    "script": {
        "spellEffect": {
            "type": "ForEach",
