                "trigger": {
                    "type": "ZoneChangeEvent",
                    "to": "Battlefield"
                },
                "effect": {
                    "type": "CreateTokenCopyOfTarget",
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    },
                    "count": {
                        "type": "Fixed",
                        "amount": 2
                    },
                    "overridePower": 3,
                    "overrideToughness": 3,
                    "addedKeywords": [
                        "FLYING"
                    ],
                    "addedSubtypes": [
                        "Dragon"
                    ],
                    "addCardTypes": [
                        "CREATURE"
                    ]
                },
                "targetRequirement": {
                    "type": "TargetObject",
                    "filter": {
                        "baseFilter": "noncreature permanent"
                    },
                    "id": "t0"
                },
                "descriptionOverride": "Project Image — Create two tokens that are copies of target noncreature permanent, except they're 3/3 Dragon creatures with flying."
            }
        ]
    },
    "metadata": {
        "collectorNumber": "613",
        "rarity": "RARE",
        "artist": "Anastasia Ovchinnikova",
        "imageUri": "https://cards.scryfall.io/normal/front/b/5/b5bf8b03-1f5c-46c5-a684-ae5c04630286.jpg?1783922540",
        "rulings": [
            {
                "date": "2022-06-10",
                "text": "Except for power, toughness, types, and the flying ability, the token copies exactly what was printed on the original permanent and nothing else (unless that permanent is copying something else or is a token; see below). It doesn't copy whether that permanent is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, and so on."
            },
            {
                "date": "2022-06-10",
                "text": "If the copied permanent has {X} in its mana cost, X is considered to be 0."
            },
            {
                "date": "2022-06-10",
                "text": "If the copied permanent is a token, the new token that's created copies the original characteristics of that token, with the exceptions noted above."
            },
            {
                "date": "2022-06-10",
                "text": "If the copied permanent is copying something else, then the token enters the battlefield as whatever that permanent copied, with the exceptions noted above."
            },
            {
                "date": "2022-06-10",
                "text": "Any enters-the-battlefield abilities of the copied permanent will trigger when the token enters the battlefield. Any “as [this permanent] enters the battlefield” or “[this permanent] enters the battlefield with” abilities of the chosen permanent will also work."
            },
            {
                "date": "2022-06-10",
                "text": "If you target an Aura with Astral Dragon's ability, no tokens will be created."
            },
            {
                "date": "2022-06-10",
                "text": "Since the tokens are creatures, they can't attack or {T} until your next turn if they don't have haste."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE"
    ]
}

