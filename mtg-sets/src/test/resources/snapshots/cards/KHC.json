// Elderfang Venom
{
    "name": "Elderfang Venom",
    "manaCost": "{2}{B}{G}",
    "typeLine": "Enchantment",
    "oracleText": "Attacking Elves you control have deathtouch.\nWhenever an Elf you control dies, each opponent loses 1 life and you gain 1 life.",
    "script": {
        "triggeredAbilities": [
            {
                "id": "Elderfang Venom:1",
                "trigger": {
                    "type": "ZoneChangeEvent",
                    "filter": "permanent Elf ctrl:you",
                    "from": "Battlefield",
                    "to": "Graveyard"
                },
                "binding": "ANY",
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "LoseLife",
                            "amount": {
                                "type": "Fixed",
                                "amount": 1
                            },
                            "target": {
                                "type": "PlayerRef",
                                "player": "EachOpponent"
                            }
                        },
                        {
                            "type": "GainLife",
                            "amount": {
                                "type": "Fixed",
                                "amount": 1
                            }
                        }
                    ]
                }
            }
        ],
        "staticAbilities": [
            {
                "type": "GrantKeyword",
                "keyword": "DEATHTOUCH",
                "filter": {
                    "baseFilter": "creature Elf attacking ctrl:you"
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "15",
        "rarity": "RARE",
        "artist": "Alessandra Pisano",
        "flavorText": "\"The Cosmos Serpent favored us with his venom. As thanks, we sink fangs into those who dishonor the old ways.\"",
        "imageUri": "https://cards.scryfall.io/normal/front/7/d/7d5bbb02-a04e-4add-ae9a-67819cffdb3a.jpg?1783928335"
    },
    "colorIdentityOverride": [
        "BLACK",
        "GREEN"
    ]
}

// Lathril, Blade of the Elves
{
    "name": "Lathril, Blade of the Elves",
    "manaCost": "{2}{B}{G}",
    "typeLine": "Legendary Creature — Elf Noble",
    "oracleText": "Menace (This creature can't be blocked except by two or more creatures.)\nWhenever Lathril deals combat damage to a player, create that many 1/1 green Elf Warrior creature tokens.\n{T}, Tap ten untapped Elves you control: Each opponent loses 10 life and you gain 10 life.",
    "creatureStats": {
        "power": 2,
        "toughness": 3
    },
    "keywords": [
        "MENACE"
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Lathril, Blade of the Elves:1",
                "trigger": {
                    "type": "DealsDamageEvent",
                    "damageType": "DamageCombat",
                    "recipient": {
                        "type": "RecipientPlayer",
                        "player": "Any"
                    }
                },
                "effect": {
                    "type": "CreateToken",
                    "count": {
                        "type": "ContextProperty",
                        "key": "TRIGGER_DAMAGE_AMOUNT"
                    },
                    "power": 1,
                    "toughness": 1,
                    "colors": [
                        "GREEN"
                    ],
                    "creatureTypes": [
                        "Elf",
                        "Warrior"
                    ],
                    "imageUri": "https://cards.scryfall.io/normal/front/1/1/118d0655-5719-4512-8bc1-fe759669811b.jpg?1783928078"
                },
                "descriptionOverride": "Whenever Lathril deals combat damage to a player, create that many 1/1 green Elf Warrior creature tokens."
            }
        ],
        "activatedAbilities": [
            {
                "id": "Lathril, Blade of the Elves:2",
                "cost": {
                    "type": "CostComposite",
                    "costs": [
                        "CostTap",
                        {
                            "type": "CostAtomWrapper",
                            "atom": {
                                "type": "AtomTapPermanents",
                                "count": 10,
                                "filter": "creature Elf",
                                "excludeSelf": true
                            }
                        }
                    ]
                },
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "LoseLife",
                            "amount": {
                                "type": "Fixed",
                                "amount": 10
                            },
                            "target": {
                                "type": "PlayerRef",
                                "player": "EachOpponent"
                            }
                        },
                        {
                            "type": "GainLife",
                            "amount": {
                                "type": "Fixed",
                                "amount": 10
                            }
                        }
                    ]
                },
                "descriptionOverride": "Each opponent loses 10 life and you gain 10 life."
            }
        ]
    },
    "metadata": {
        "collectorNumber": "1",
        "rarity": "MYTHIC",
        "artist": "Caroline Gariba",
        "imageUri": "https://cards.scryfall.io/normal/front/5/4/547888c3-a9a6-4413-b29a-6bcd8a9279bf.jpg?1783928341",
        "rulings": [
            {
                "date": "2021-02-05",
                "text": "You can tap any ten untapped Elves you control, including ones you haven't controlled continuously since the beginning of your most recent turn, to pay that part of the cost of Lathril's activated ability. You must have controlled Lathril continuously since the beginning of your most recent turn, however. Lathril doesn't count as one of the ten."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLACK",
        "GREEN"
    ]
}

// Pact of the Serpent
{
    "name": "Pact of the Serpent",
    "manaCost": "{1}{B}{B}",
    "typeLine": "Sorcery",
    "oracleText": "Choose a creature type. Target player draws X cards and loses X life, where X is the number of creatures they control of the chosen type.",
    "script": {
        "spellEffect": {
            "type": "Composite",
            "effects": [
                {
                    "type": "ChooseOption",
                    "optionType": "CREATURE_TYPE",
                    "storeAs": "chosen0"
                },
                {
                    "type": "StoreNumber",
                    "name": "number1",
                    "amount": {
                        "type": "AggregateBattlefield",
                        "player": {
                            "type": "BoundVariable",
                            "name": "t0"
                        },
                        "filter": {
                            "cardPredicates": [
                                "IsCreature",
                                {
                                    "type": "HasSubtypeFromVariable",
                                    "variableName": "chosen0"
                                }
                            ]
                        }
                    }
                },
                {
                    "type": "DrawCards",
                    "count": {
                        "type": "VariableReference",
                        "variableName": "number1"
                    },
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    }
                },
                {
                    "type": "LoseLife",
                    "amount": {
                        "type": "VariableReference",
                        "variableName": "number1"
                    },
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    }
                }
            ]
        },
        "targetRequirements": [
            {
                "type": "TargetPlayer",
                "id": "t0"
            }
        ]
    },
    "metadata": {
        "collectorNumber": "9",
        "rarity": "RARE",
        "artist": "Donato Giancola",
        "flavorText": "\"Our quarrels behind us. Our foes before us. Death or triumph for us all!\"",
        "imageUri": "https://cards.scryfall.io/normal/front/c/5/c5b3d118-ba4b-4a93-92a2-cd763de49d29.jpg?1783928337",
        "rulings": [
            {
                "date": "2021-02-05",
                "text": "You choose the target player as you cast Pact of the Serpent, but you don't choose the creature type until the spell resolves."
            },
            {
                "date": "2021-02-05",
                "text": "The value of X is based on the number of creatures the player controls of the chosen type as Pact of the Serpent resolves."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLACK"
    ]
}

