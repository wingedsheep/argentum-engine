    "name": "Worms of the Earth",
    "manaCost": "{2}{B}{B}{B}",
    "typeLine": "Enchantment",
    "oracleText": "Players can't play lands.\nLands can't enter the battlefield.\nAt the beginning of each upkeep, any player may sacrifice two lands of their choice or have this enchantment deal 5 damage to that player. If a player does either, destroy this enchantment.",
    "script": {
        "triggeredAbilities": [
            {
                "id": "ability_1",
                "trigger": {
                    "type": "StepEvent",
                    "step": "UPKEEP",
                    "player": "Each"
                },
                "binding": "ANY",
                "effect": {
                    "type": "ForEach",
                    "space": {
                        "type": "IterationSpace.Players",
                        "players": "ActivePlayerFirst"
                    },
                    "body": {
                        "type": "Gated",
                        "gate": {
                            "type": "Gate.MayDecide",
                            "prompt": "Buy your way out of Worms of the Earth?"
                        },
                        "then": {
                            "type": "Modal",
                            "modes": [
                                {
                                    "effect": {
                                        "type": "Gated",
                                        "gate": {
                                            "type": "Gate.WhenCondition",
                                            "condition": {
                                                "type": "Compare",
                                                "left": {
                                                    "type": "AggregateBattlefield",
                                                    "player": "You",
                                                    "filter": "land"
                                                },
                                                "operator": "GTE",
                                                "right": {
                                                    "type": "Fixed",
                                                    "amount": 2
                                                }
                                            }
                                        },
                                        "then": {
                                            "type": "Composite",
                                            "effects": [
                                                {
                                                    "type": "ForceSacrifice",
                                                    "filter": "land",
                                                    "count": 2,
                                                    "target": "Controller"
                                                },
                                                {
                                                    "type": "MoveToZone",
                                                    "target": "Self",
                                                    "destination": "Graveyard",
                                                    "byDestruction": true
                                                }
                                            ]
                                        }
                                    },
                                    "description": "Sacrifice two lands"
                                },
                                {
                                    "effect": {
                                        "type": "Composite",
                                        "effects": [
                                            {
                                                "type": "DealDamage",
                                                "amount": {
                                                    "type": "Fixed",
                                                    "amount": 5
                                                },
                                                "target": "Controller"
                                            },
                                            {
                                                "type": "MoveToZone",
                                                "target": "Self",
                                                "destination": "Graveyard",
                                                "byDestruction": true
                                            }
                                        ]
                                    },
                                    "description": "Take 5 damage from Worms of the Earth"
                                }
                            ],
                            "countsAsModalSpell": false
                        },
                        "decisionMaker": "Controller"
                    }
                },
                "descriptionOverride": "At the beginning of each upkeep, any player may sacrifice two lands of their choice or have this enchantment deal 5 damage to that player. If a player does either, destroy this enchantment."
            }
        ],
        "staticAbilities": [
            "PlayersCantPlayLands",
            "LandsCantEnterTheBattlefield"
        ]
    },
    "metadata": {
        "collectorNumber": "56",
        "rarity": "RARE",
        "artist": "Anson Maddocks",
        "flavorText": "The ground collapsed, leaving nothing but the great Worms' mucous residues.",
        "imageUri": "https://cards.scryfall.io/normal/front/6/5/65a97821-ca5b-46fb-af08-86de81d0daac.jpg?1783947937"
    }
}

