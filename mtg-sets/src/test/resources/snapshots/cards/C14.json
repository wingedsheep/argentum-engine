// Dualcaster Mage
{
    "name": "Dualcaster Mage",
    "manaCost": "{1}{R}{R}",
    "typeLine": "Creature — Human Wizard",
    "oracleText": "Flash\nWhen this creature enters, copy target instant or sorcery spell. You may choose new targets for the copy.",
    "creatureStats": {
        "power": 2,
        "toughness": 2
    },
    "keywords": [
        "FLASH"
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Dualcaster Mage:1",
                "trigger": {
                    "type": "ZoneChangeEvent",
                    "to": "Battlefield"
                },
                "effect": {
                    "type": "CopyTargetSpell",
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    }
                },
                "targetRequirement": {
                    "type": "TargetObject",
                    "filter": {
                        "baseFilter": "instant|sorcery",
                        "zone": "Stack"
                    },
                    "id": "t0"
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "34",
        "rarity": "RARE",
        "artist": "Matt Stewart",
        "flavorText": "\"It has been my experience that disasters like to strike in pairs.\"",
        "imageUri": "https://cards.scryfall.io/normal/front/0/b/0b80c8a0-0870-4836-bee1-f4a805d119d6.jpg?1783938867",
        "rulings": [
            {
                "date": "2016-06-08",
                "text": "Dualcaster Mage's triggered ability can target (and copy) any instant or sorcery spell, not just one with targets. It doesn't matter who controls it."
            },
            {
                "date": "2016-06-08",
                "text": "As Dualcaster Mage's triggered ability resolves, it creates a copy of a spell on the stack. The copy isn't cast, so abilities that trigger when a player casts a spell won't trigger."
            },
            {
                "date": "2016-06-08",
                "text": "The copy will have the same targets as the spell it's copying unless you choose new ones. You may change any number of the targets, including all of them or none of them. If, for one of the targets, you can't choose a new legal target, then it remains unchanged (even if the current target is illegal)."
            },
            {
                "date": "2016-06-08",
                "text": "If the spell is modal (that is, it says \"Choose one —\" or the like), the copy will have the same mode. You can't choose a different one."
            },
            {
                "date": "2016-06-08",
                "text": "If the spell has an X whose value was determined as it was cast (like Earthquake does), the copy has the same value of X."
            }
        ]
    },
    "colorIdentityOverride": [
        "RED"
    ]
}

// Intellectual Offering
{
    "name": "Intellectual Offering",
    "manaCost": "{4}{U}",
    "typeLine": "Instant",
    "oracleText": "Choose an opponent. You and that player each draw three cards.\nChoose an opponent. Untap all nonland permanents you control and all nonland permanents that player controls.",
    "script": {
        "spellEffect": {
            "type": "Composite",
            "effects": [
                {
                    "type": "ChooseOpponentForSource",
                    "prompt": "Choose an opponent: you and that player each draw three cards"
                },
                {
                    "type": "DrawCards",
                    "count": {
                        "type": "Fixed",
                        "amount": 3
                    }
                },
                {
                    "type": "DrawCards",
                    "count": {
                        "type": "Fixed",
                        "amount": 3
                    },
                    "target": {
                        "type": "PlayerRef",
                        "player": "ChosenOpponent"
                    }
                },
                {
                    "type": "ChooseOpponentForSource",
                    "prompt": "Choose an opponent: untap all nonland permanents you and that player control"
                },
                {
                    "type": "ForEach",
                    "space": {
                        "type": "IterationSpace.Group",
                        "filter": {
                            "baseFilter": "nonland permanent ctrl:you"
                        }
                    },
                    "body": {
                        "type": "TapUntap",
                        "target": "IterationEntity",
                        "tap": false
                    }
                },
                {
                    "type": "ForEach",
                    "space": {
                        "type": "IterationSpace.Players",
                        "players": "ChosenOpponent"
                    },
                    "body": {
                        "type": "ForEach",
                        "space": {
                            "type": "IterationSpace.Group",
                            "filter": {
                                "baseFilter": "nonland permanent ctrl:you"
                            }
                        },
                        "body": {
                            "type": "TapUntap",
                            "target": "IterationEntity",
                            "tap": false
                        }
                    }
                }
            ]
        }
    },
    "metadata": {
        "collectorNumber": "15",
        "rarity": "RARE",
        "artist": "Mark Winters",
        "imageUri": "https://cards.scryfall.io/normal/front/6/3/63de9e39-3c16-452f-9f06-4c1298752f57.jpg?1783938871",
        "rulings": [
            {
                "date": "2014-11-07",
                "text": "You may choose the same opponent for each of the effects, or you may choose different opponents. None of the affected players are targets of the spell."
            },
            {
                "date": "2014-11-07",
                "text": "You choose the opponents for each effect as the spell resolves."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE"
    ]
}

