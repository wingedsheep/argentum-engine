            "power": 5,
            "toughness": 4
        },
        "keywords": [
            "FLYING"
        ],
        "metadata": {
            "collectorNumber": "49",
            "rarity": "UNCOMMON",
            "artist": "Nils Hamm",
            "flavorText": "The final pages of the experiment log were blank. Investigators found it abandoned on a desk in the researcher's lab, open, the pages flipping in the wind from a shattered window.",
