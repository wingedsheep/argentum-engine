// Sakashima's Student
{
    "name": "Sakashima's Student",
    "manaCost": "{2}{U}{U}",
    "typeLine": "Creature — Human Ninja",
    "oracleText": "Ninjutsu {1}{U} ({1}{U}, Return an unblocked attacker you control to hand: Put this card onto the battlefield from your hand tapped and attacking.)\nYou may have this creature enter as a copy of any creature on the battlefield, except it's a Ninja in addition to its other creature types.",
    "creatureStats": {
        "power": 0,
        "toughness": 0
    },
    "keywords": [
        "NINJUTSU"
    ],
    "keywordAbilities": [
        {
            "type": "Ninjutsu",
            "cost": "{1}{U}"
        }
    ],
    "script": {
        "activatedAbilities": [
            {
                "id": "ninjutsu_{1}{U}",
                "cost": {
                    "type": "CostComposite",
                    "costs": [
                        {
                            "type": "CostAtomWrapper",
                            "atom": {
                                "type": "AtomMana",
                                "cost": "{1}{U}"
                            }
                        },
                        {
                            "type": "CostAtomWrapper",
                            "atom": {
                                "type": "AtomReturnToHand",
                                "filter": {
                                    "cardPredicates": [
                                        "IsCreature"
                                    ],
                                    "statePredicates": [
                                        "IsAttacking",
                                        "IsUnblocked"
                                    ]
                                }
                            }
                        }
                    ]
                },
                "effect": {
                    "type": "MoveToZone",
                    "target": "Self",
                    "destination": "Battlefield",
                    "placement": "TappedAndAttacking",
                    "fromZone": "Hand",
                    "attackDefender": "RETURNED_ATTACKER"
                },
                "activateFromZone": "Hand",
                "descriptionOverride": "Ninjutsu {1}{U} ({1}{U}, Return an unblocked attacker you control to hand: Put this card onto the battlefield from your hand tapped and attacking.)",
                "keyword": "NINJUTSU"
            }
        ],
        "replacementEffects": [
            {
                "type": "EntersAsCopy",
                "additionalSubtypes": [
                    "Ninja"
                ]
            }
        ]
    },
    "metadata": {
        "collectorNumber": "24",
        "rarity": "RARE",
        "artist": "Brian Snõddy",
        "imageUri": "https://cards.scryfall.io/normal/front/8/c/8c3d4d71-c750-4146-80fb-7cfd2427c62f.jpg?1783940629",
        "rulings": [
            {
                "date": "2012-06-01",
                "text": "Because you return the unblocked attacking creature to its owner's hand while activating the ninjutsu ability, you can't have Sakashima's Student enter as a copy of that creature."
            },
            {
                "date": "2012-06-01",
                "text": "Sakashima's Student copies exactly what was printed on the original creature (unless that creature is copying something else or is a token) and it is a Ninja in addition to its other types. It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or any Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on."
            },
            {
                "date": "2012-06-01",
                "text": "You can choose not to copy anything. In that case, Sakashima's Student enters as a 0/0 creature, and is probably put into the graveyard immediately."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE"
    ]
}

