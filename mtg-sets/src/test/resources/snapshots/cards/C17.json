                "type": "ModifySpellCost",
                "target": {
                    "type": "YouCast",
                    "filter": {
                        "cardPredicates": [
                            "IsCreature",
                            "HasChosenSubtype"
                        ]
                    }
                },
                "modification": {
                    "type": "ReduceGeneric",
                    "amount": 1
                }
