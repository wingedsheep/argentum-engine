// Kefka, Dancing Mad
{
    "name": "Kefka, Dancing Mad",
    "manaCost": "{5}{B}{R}",
    "typeLine": "Legendary Creature — Human Wizard",
    "oracleText": "During your turn, Kefka has indestructible.\nAt the beginning of your end step, exile a card at random from each opponent's graveyard. You may cast any number of spells from among cards exiled this way without paying their mana costs. Then each player who owns a spell you cast this way loses life equal to its mana value.",
    "creatureStats": {
        "power": 6,
        "toughness": 6
    },
    "script": {
