                    ]
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "187",
        "rarity": "RARE",
        "artist": "Loïc Canavaggia",
        "imageUri": "https://cards.scryfall.io/normal/front/f/b/fbdaa29b-85ff-4a06-b27e-fcdbdfd4a3fe.jpg?1783907862",
