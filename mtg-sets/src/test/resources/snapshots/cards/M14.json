                            "toughness": 2,
                            "colors": [
                                "WHITE"
                            ],
                            "creatureTypes": [
                                "Cat"
                            ],
                            "imageUri": "https://cards.scryfall.io/normal/front/d/b/db41ce71-52df-4bc1-884d-b09419d8dd13.jpg?1783939884"
                        },
                        {
                            "type": "Gated",
                            "gate": {
                                "type": "Gate.WhenCondition",
                                "condition": {
                                    "type": "EntityMatches",
                                    "entity": "TriggeringEntity",
                                    "filter": {
                                        "cardPredicates": [
                                            "IsEnchantment",
                                            {
                                                "type": "HasSubtype",
                                                "subtype": "Aura"
                                            }
                                        ],
