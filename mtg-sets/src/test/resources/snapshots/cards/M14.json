                    "player": "You",
                    "tracker": "LIFE_GAINED"
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "200",
        "rarity": "UNCOMMON",
        "artist": "Igor Kieryluk",
        "flavorText": "Shepherds in Kalonia know it's better to let sheep roam than have them be trapped when the wurms are feeding.",
