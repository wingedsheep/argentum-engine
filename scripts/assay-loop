#!/usr/bin/env bash
# Widen Argentum Assay's grammar with headless Claude Code or Codex, one fresh session per step and
# one band (a decline family) per PR — only over Oracle text the engine already expresses.
#   just assay-loop [model] [focus]    e.g. just assay-loop opus "kicker conditions"
# Stop it with Ctrl-C, or `touch .claude/loop-runs/assay.stop` to stop after the current step.
# When the subscription's usage limit is hit, it waits and retries.
set -uo pipefail

models() {
  cat <<'EOF2'
Model       CLI           Selection
sonnet      Claude Code   Claude's sonnet alias
opus        Claude Code   Claude's opus alias
astra       Codex         gpt-6-astra

Full claude-* and gpt-* model IDs also work.
Use codex:<model-id> to select any Codex model ID.
GPT model IDs are normalized to lowercase; other IDs pass through unchanged.
Omitting the model uses MODEL, or claude-opus-5-5 when MODEL is unset.
EOF2
}

usage() {
  cat <<'EOF2'
Usage: just assay-loop [model] [focus]

Teaches Assay's grammar, one band per PR, to read declines on cards we have already hand-written
(`just assay-report --implemented --rank tail`). Families needing new SDK vocabulary are skipped
and recorded in the ledger at .claude/loop-runs/assay-grammar.md.

Examples:
  just assay-loop                             # claude-opus-5-5, whatever the probe ranks highest
  just assay-loop sonnet
  just assay-loop astra
  just assay-loop codex:gpt-6-sol
  just assay-loop opus "kicker / cast-history conditions"
  just assay-loop opus CardPredicate
  just assay-loop pick                        # Choose from a menu
  just assay-loop --models                    # Show model shortcuts

EOF2
  models
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --models) models; exit 0 ;;
esac
if [ "$#" -gt 2 ]; then usage >&2; exit 2; fi

FOCUS=${2:-}
MODEL=${1:-${MODEL:-claude-opus-5-5}}
if [ "$MODEL" = pick ]; then
  if [ ! -t 0 ]; then
    echo "assay-loop: pick needs a terminal; pass sonnet, opus, astra, or a full model ID" >&2
    exit 2
  fi
  PS3="Choose a model (Ctrl-C to cancel): "
  select choice in sonnet opus astra "Custom Codex model"; do
    case "$choice" in
      "Custom Codex model")
        read -r -p "Codex model ID: " custom_model || exit 2
        if [ -z "$custom_model" ]; then
          echo "Enter a model ID." >&2
          continue
        fi
        MODEL="codex:$custom_model"
        break
        ;;
      "") echo "Choose 1, 2, 3, or 4." >&2 ;;
      *) MODEL=$choice; break ;;
    esac
  done
  [ "$MODEL" != pick ] || exit 2
fi
# Codex's picker displays GPT names with capitals, but its model IDs are lowercase.
# Normalize only GPT IDs so custom provider IDs keep their original spelling.
case "$MODEL" in
  [gG][pP][tT]-*|codex:[gG][pP][tT]-*)
    NORMALIZED_MODEL=$(printf '%s' "$MODEL" | tr '[:upper:]' '[:lower:]')
    if [ "$MODEL" != "$NORMALIZED_MODEL" ]; then
      echo "assay-loop: model '$MODEL' normalized to '$NORMALIZED_MODEL'"
      MODEL=$NORMALIZED_MODEL
    fi
    ;;
esac
case "$MODEL" in
  codex:)
    echo "assay-loop: codex: requires a model ID" >&2
    exit 2
    ;;
  codex:*) MODEL=${MODEL#codex:}; HARNESS=codex ;;
  astra) MODEL=gpt-6-astra; HARNESS=codex ;;
  gpt-*) HARNESS=codex ;;
  *) HARNESS=claude ;;
esac
command -v "$HARNESS" >/dev/null || { echo "assay-loop: $HARNESS is not installed" >&2; exit 1; }
REPO=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
RUNS="$REPO/.claude/loop-runs"
mkdir -p "$RUNS"

FOCUS_LINE="Focus: none — take whatever the probe ranks highest."
[ -z "$FOCUS" ] || FOCUS_LINE="Focus: '$FOCUS' — PICK prefers families in this theme or SDK family while any in-scope one is left, then falls back to the full ranking."

PROMPT="You are one iteration of an unattended loop that widens Argentum Assay's grammar (oracle-assay/), one
band per PR. A band is one decline family taught to the grammar in both directions, landing on SDK values
hand-written cards already use. You are a fresh session: your memory is the ledger at
$RUNS/assay-grammar.md (create it if missing, gitignored, never commit it) and GitHub. Do exactly ONE of
the steps below, then stop.
$FOCUS_LINE

Scope — Oracle text the engine ALREADY expresses, nothing else:
- The work list is \`just assay-report --implemented --rank tail\`: declines on cards that already have a
  golden, so the SDK provably expresses them and the differential has an answer key.
- Never add or change mtg-sdk / rules-engine vocabulary (types, fields, facades). A family that needs it
  is 'needs-sdk': record it in the ledger and pick another. Card definitions the differential proves wrong
  ARE fixed in the band's PR.
- Out of scope, never picked: multi-face layouts (adventure, split, MDFC, transform, flip, rooms, prepare/
  omen), ability-word markers, presentation fields, and the minority spelling of two SDK spellings of one
  concept (see oracle-assay/README.md and, when present, backlog/assay-engine-gap-analysis.md 'Not gaps').

Ledger format: a '## Bands' section, one line per family:
\`- [ ] <band name> — key '<tail key>' — probe <lines>/<whole cards> — <note>\`, with [~] building,
[x] merged (add PR number and delivered whole-card delta), [s] needs-sdk (say what's missing),
[-] out of scope, [!] needs human.

Other loops may run at the same time, so everything this loop owns is named by the prefix 'loop-assay-':
every branch you create is 'loop-assay-<short-slug>', and its worktree is
$REPO/.claude/worktrees/loop-assay-<short-slug>. Find our open PR by branch name only:
\`gh pr list --author @me --state open --json number,headRefName --jq '.[] | select(.headRefName | startswith(\"loop-assay-\"))'\`
Never touch a PR, branch or worktree without our prefix. Work on our PR in its worktree (recreate it with
\`git worktree add\` if missing). Never work in the main checkout. Every oracle-assay binary you run must be
built from that worktree (\`just assay …\` recipes rebuild it) — a stale binary makes before/after meaningless.

1. PR open, CI failed -> read only the failing log tail (\`gh run view <id> --log-failed | tail -200\`),
   fix it, re-run the affected gate per the verify skill, push. A known-flaky test: \`gh run rerun --failed\` instead.
2. PR open, has merge conflicts -> rebase on origin/main. Grammar conflicts: resolve by hand, then re-run
   \`just assay-gate\`. The verdict ledger (game-server/src/main/resources/coverage/assay-verdicts.json) and
   card goldens: never hand-merge — take main's and regenerate with \`just assay-bake\` / \`just rebless-cards\`.
   Gate, push.
3. PR open, CI green, not yet reviewed (no 'loop-reviewed' comment) -> review it with the review-changes skill,
   fix what holds up (re-bake if the grammar changed), gate, push, and post a PR comment starting
   'loop-reviewed' listing fixes and declines.
4. PR open, CI green, reviewed, nothing pushed since -> \`gh pr merge --squash --delete-branch\` (from $REPO, after
   \`git worktree remove\` of its worktree), mark the band [x] in the ledger.
5. No PR open -> build the next band. \`git fetch\`, new worktree + 'loop-assay-' branch from origin/main.
   a. PICK. Run \`just assay-report --implemented --rank tail --top 40\`. Skip every family already in the
      ledger (any status) and every out-of-scope one (record those as [-]). For the ~8 best remaining,
      measure what each would FINISH with the prefix probe: start \`just assay-explore --no-open --port 7399\`
      in the background (another port if taken), POST
      {\"by\":\"tail\",\"key\":\"<key>\",\"find\":\"<span>\",\"replace\":\"<text the grammar already reads>\",\"regex\":\"false\"}
      to http://127.0.0.1:7399/api/probe, then stop the server. Check each candidate's target SDK values
      appear in the goldens (mtg-sets/src/test/resources/snapshots/cards/); if not, it is needs-sdk ([s]).
      The rank names lines a family touches, not cards it finishes — choose by the probe's whole cards.
      Mark the chosen band [~] with its probe numbers.
   b. BASELINE before any grammar edit, in the worktree: \`just assay-report --implemented | tail -25\`
      (whole cards) and \`just assay-differential | tail -8\` (compared / confirmed / divergent).
   c. BUILD. Read oracle-assay/README.md ('The three things that make this different', 'Reading the
      verdicts', the two most recent band sections) and docs/sdk-design-principles.md. Write the rules under
      oracle-assay/src/main/kotlin/com/wingedsheep/assay/grammar/: every rule both builds and matches,
      parses straight into existing mtg-sdk types through the companion factories / facades the cards use,
      and reuses existing slots before adding one. Add grammar tests beside the existing ones in
      oracle-assay/src/test/. If it cannot be done without SDK vocabulary: revert your edits, mark [s], and
      end with STEP 5 DONE (no PR).
   d. PROVE. \`just assay-gate\` must report 0 mismatch, 0 ambiguous, 0 non-invertible. \`just assay-differential\`:
      classify ONLY the divergences new against the baseline — parser bug (fix the grammar), card bug (fix the
      card to the reading, CR-checked; \`just rebless-cards\`; only those cards may move in the golden), or
      standing SDK finding (leave it, name it in the PR). An unclassifiable divergence is STUCK.
   e. Add a short band section to oracle-assay/README.md in the house style: the family, probe vs delivered,
      what it found. Commit by explicit path, never \`git add -A\`: grammar + tests + README; then card fixes +
      goldens (if any); then \`just assay-bake\` and the verdict ledger JSON in its own commit.
   f. Gate: \`just build\`. Push, open a PR titled '[agent-loop: $MODEL] Assay: <band> band' whose body gives the
      family and tail key, probe vs delivered, whole cards before -> after, differential before -> after with
      the classification counts, any card bugs fixed by name, that it came from an agentic loop driven by
      $MODEL, and that fixed cards were not play-tested beyond their existing tests.

PR open, CI still pending or running -> do nothing; don't poll or wait on it — the loop waits for CI
between sessions. Answer WAITING_CI.

If a step fails twice for the same PR, comment on it, mark the band [!] in the ledger, and move on. When PICK
finds no in-scope family whose probe finishes at least one whole card, or the last three PICKs all ended
[s], answer ASSAY_COMPLETE with the ledger's totals.
Follow AGENTS.md; mtgish is irrelevant here and never blocks. Never revert or stash work that isn't yours.
An unrelated failure on origin/main (a test in a module your change doesn't touch) is NOT a reason to answer
STUCK: run the gates for the modules you changed, note the unrelated failure in the ledger and the PR body,
and carry on. Only answer STUCK when the failure is inside code your band changed or depends on.

A human watches your text live, one line at a time, so keep them posted in short lines (under 150 chars each):
- once you know which step you're taking: 'Working on: <step and band, e.g. step 5, kicker condition band>'
- whenever you learn something that changes the plan — a family marked needs-sdk, a probe that disappointed,
  a divergence's classification, a review finding you fixed or declined: 'Finding: <one line>'
- just before your final line, one to three lines: 'Summary: <what you did / what's next>'
No other long prose.
End your reply with exactly one line: STEP <n> DONE | WAITING_CI | ASSAY_COMPLETE | STUCK <reason>"

if [ "$HARNESS" = codex ]; then
  PROMPT="$PROMPT

Read the applicable skill files in .agents/skills/ (review-changes/SKILL.md, verify/SKILL.md). If subagents
are unavailable, perform their steps inline."
elif [ "$MODEL" = sonnet ] || [ "$MODEL" = opus ]; then
  PROMPT="$PROMPT

The requested model '$MODEL' is a Claude alias. Before opening a PR, resolve the actual driving
model ID from your session's system information and use it instead of '$MODEL' in every
[agent-loop: ...] title and model attribution. Never guess a version; if it cannot be determined,
answer STUCK cannot determine driving model ID."
fi

# Everything the loop prints also goes to the run log.
LOGDIR="$RUNS/assay-logs"
mkdir -p "$LOGDIR"
exec > >(tee -a "$RUNS/assay.log") 2>&1
log() { echo "[$(date '+%F %T')] $*"; }

# One line per action the session takes, streamed live: its messages and each tool call.
PRETTY='select(.type == "assistant") | .message.content[]? |
  (if .type == "text" then
     ([.text | split("\n")[] | select(test("^(Working on|Finding|Summary):"))]) as $m
     | if ($m | length) > 0 then $m[]
         | (if startswith("Working on") then "   🔨 " elif startswith("Finding") then "   🔎 " else "   📋 " end) + .[0:200]
       else "   💬 " + (.text | split("\n")[0] | .[0:160]) end
   elif .type == "tool_use" then "   → " + .name + ": " +
     ((.input.description // .input.command // .input.skill // .input.file_path // .input.pattern
       // .input.prompt // "") | tostring | split("\n")[0] | .[0:140])
   else empty end)'

if [ "$HARNESS" = codex ]; then
  PRETTY='if .type == "item.completed" and .item.type == "agent_message" then
      .item.text | split("\n")[] | select(length > 0) | "   💬 " + .[0:200]
    elif .type == "item.started" and .item.type == "command_execution" then
      "   → " + (.item.command | split("\n")[0] | .[0:140])
    elif .type == "error" or .type == "turn.failed" then
      "   ! " + (.message // .error.message // "Codex turn failed")
    else empty end'
fi

log "assay-loop started${FOCUS:+ (focus: $FOCUS)} (harness $HARNESS, model $MODEL, log $RUNS/assay.log)"
N=0
while [ ! -e "$RUNS/assay.stop" ]; do
  N=$((N + 1))
  # Wait on CI for free instead of spending a session on it.
  PR=$(gh pr list --author @me --state open --json number,headRefName \
        --jq "[.[] | select(.headRefName | startswith(\"loop-assay-\"))][0].number // empty")
  if [ -n "$PR" ]; then
    log "waiting for CI on PR #$PR"
    sleep 60
    gh pr checks "$PR" --watch >/dev/null 2>&1
    log "CI on PR #$PR: $(gh pr checks "$PR" --json bucket --jq '[.[].bucket] | group_by(.) | map("\(.[0])=\(length)") | join(" ")' 2>/dev/null)"
  fi

  TRANSCRIPT="$LOGDIR/$(date '+%Y%m%d-%H%M%S')-iter$N.jsonl"
  log "iteration $N (PR: ${PR:-none}) — transcript $TRANSCRIPT"
  if [ "$HARNESS" = codex ]; then
    FINAL_FILE="${TRANSCRIPT%.jsonl}.txt"
    # A failed launch must never reuse a stale completion marker.
    rm -f "$FINAL_FILE"
    (cd "$REPO" && codex exec --model "$MODEL" --approve-for-me --json \
        --output-last-message "$FINAL_FILE" "$PROMPT" 2>&1) \
      | tee "$TRANSCRIPT" | jq -Rr --unbuffered "fromjson? | $PRETTY"
    SESSION_STATUS=$?
    RESULT=$(cat "$FINAL_FILE" 2>/dev/null || true)
    FINAL=$RESULT
    STATS="exit $SESSION_STATUS"
  else
    (cd "$REPO" && claude -p "$PROMPT" --model "$MODEL" --permission-mode "${PERMISSION_MODE:-auto}" \
        --output-format stream-json --verbose 2>&1) \
      | tee "$TRANSCRIPT" | jq -Rr --unbuffered "fromjson? | $PRETTY"

    FINAL=$(jq -Rc 'fromjson? | select(.type == "result")' "$TRANSCRIPT" 2>/dev/null | tail -1)
    RESULT=$(echo "$FINAL" | jq -r '.result // empty' 2>/dev/null)

    STATS=$(echo "$FINAL" | jq -r '"\(.num_turns // "?") turns, \((.duration_ms // 0) / 60000 | floor) min"' 2>/dev/null)
  fi
  LAST=$(echo "$RESULT" | tail -1)
  log "iteration $N finished: ${LAST:-<no result>} ($STATS)"

  if grep -qiE 'usage limit|session limit|hit your limit|rate limit|overloaded|quota exceeded' <<<"$RESULT$(tail -5 "$TRANSCRIPT")"; then
    log "limit reached — waiting 15 min"; sleep 900; continue
  fi
  if [ "$HARNESS" = codex ] && { [ "$SESSION_STATUS" -ne 0 ] || [ -z "$FINAL" ]; }; then
    log "Codex failed or returned no final message — see $TRANSCRIPT"
    tail -5 "$TRANSCRIPT"
    exit 1
  fi
  if [ -z "$FINAL" ]; then
    log "no result — waiting 30 min"; sleep 1800; continue
  fi
  case $LAST in
    WAITING_CI*)   log "session saw CI pending — waiting on it next iteration" ;;
    ASSAY_COMPLETE*) log "assay loop complete — nothing in scope left"; exit 0 ;;
    STUCK*)        log "stuck — see the ledger at $RUNS/assay-grammar.md"; exit 1 ;;
  esac
done
log "stop file found — stopping"
rm -f "$RUNS/assay.stop"
