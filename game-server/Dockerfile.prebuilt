# Runtime-only image for CI: the deploy workflow builds game-server.jar on the runner (where it can
# reuse the Gradle build cache CI saved on main) and passes game-server/build/libs as the build
# context. game-server/Dockerfile remains the self-contained build for anyone without a JDK.
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY game-server.jar app.jar
# Stamped onto every recorded replay (see EngineVersion) so a replay that stops re-simulating can be
# traced back to the build that recorded it. Mirrors the frontend's COMMIT_HASH build arg.
ARG COMMIT_HASH=unknown
ENV APP_VERSION=$COMMIT_HASH
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
