# Normalize detected text to LF in Git. Checkout line endings follow core.eol
# (native = CRLF on Windows) unless pinned below. Binary files are left unchanged.
* text=auto

# Interpreted by bash/sh/python via a shebang or by `just`: a CR breaks them, so
# keep LF on every platform.
*.sh text eol=lf
*.py text eol=lf
justfile text eol=lf
gradlew text eol=lf
scripts/* text eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Compiled from :mtg-search by `just search-js`; review the Kotlin, not this.
web-client/src/generated/** linguist-generated=true -diff

# Compared byte-for-byte by tests (`SdkIndexTest`, golden snapshots, baselines): a CRLF checkout
# (Windows `core.autocrlf=true`) makes them fail even though nothing changed.
docs/sdk-index.md text eol=lf
**/src/test/resources/** text eol=lf
